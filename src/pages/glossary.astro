---
import Layout from '../layouts/Layout.astro';
import { glossary } from '../lib/glossary';
import { loadSyllabus } from '../lib/lessons';
import { lessonHref } from '../lib/tracks';

const { flat } = await loadSyllabus();
const sorted = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const groups = new Map<string, typeof sorted>();
for (const g of sorted) {
  const k = /[a-z]/i.test(g.term[0]) ? g.term[0].toUpperCase() : '#';
  groups.set(k, [...(groups.get(k) ?? []), g]);
}
const lessonOf = (id?: string) => (id ? flat.find((l) => l.id === id && l.written) : undefined);
---

<Layout title="Glossary" description="Short definitions of the terms used across the lessons.">
  <div class="mx-auto max-w-[700px]">
    <h1 class="text-3xl font-bold tracking-tight">Glossary</h1>
    <p class="mt-2 text-muted">
      {glossary.length} terms used in the lessons. In a lesson, a term with a dotted underline shows its definition when you hover or tap it.
    </p>

    <nav class="mt-6 flex flex-wrap gap-1 font-mono text-[13px]" aria-label="Letters">
      {[...groups.keys()].map((k) => <a href={`#letter-${k}`} class="rounded px-2 py-1 text-muted hover:bg-surface hover:text-fg">{k}</a>)}
    </nav>

    {
      [...groups].map(([k, terms]) => (
        <section class="mt-10" aria-labelledby={`letter-${k}`}>
          <h2 id={`letter-${k}`} class="scroll-mt-24 border-b border-line pb-2 font-display text-3xl italic text-accent">{k}</h2>
          <dl class="mt-2">
            {terms.map((g) => {
              const l = lessonOf(g.lesson);
              return (
                <div id={`term-${g.id}`} class="scroll-mt-24 border-b border-line py-4 last:border-0">
                  <dt class="flex items-baseline justify-between gap-3">
                    <span class="font-semibold">{g.term}</span>
                    <span class="font-mono text-[11px] text-muted">{g.level}</span>
                  </dt>
                  <dd class="mt-1 text-[0.95rem] leading-relaxed text-[var(--body)]">
                    {g.def}
                    {l && (
                      <a href={lessonHref(l.id)} class="mt-1 block text-[13px] font-medium text-accent hover:underline">
                        Learn more: {l.number} {l.title} →
                      </a>
                    )}
                  </dd>
                </div>
              );
            })}
          </dl>
        </section>
      ))
    }
  </div>
</Layout>
