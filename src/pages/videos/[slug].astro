---
// A series page: player on the left, every episode in a sidebar on the right, like a YouTube playlist.
import Layout from '../../layouts/Layout.astro';
import { series, slugOf, episodesOf, totalLength, watchUrl, type Video } from '../../lib/videos';
import { loadSyllabus } from '../../lib/lessons';
import { tracks, lessonHref } from '../../lib/tracks';

export function getStaticPaths() {
  return series.map((v) => ({ params: { slug: slugOf(v) }, props: { v } }));
}

const { v } = Astro.props as { v: Video };
const { total, items } = episodesOf(v);
const { flat } = await loadSyllabus();
const pair = flat.find((l) => l.id === v.pairs);
if (!pair) throw new Error(`videos.ts: "${v.title}" pairs with unknown lesson ${v.pairs}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = { pl: v.yt, items: items.map((e) => [e.v, e.t]) };
---

<Layout title={v.title} zone="cinema" description={`${v.title} by ${v.creator}: ${items.length} episodes. ${v.why}`}>
  <div class="series mx-auto max-w-[1320px]" data-section={v.track}>
    <nav class="flex items-center gap-2 font-mono text-[12px] text-muted" aria-label="Breadcrumb">
      <a href={`${base}/videos/`} class="hover:text-fg">Videos</a>
      <span aria-hidden="true">/</span>
      <span class="tc-text">{tracks[v.track].short}</span>
      <span aria-hidden="true">/</span>
      <span class="truncate">{v.creator}</span>
    </nav>

    <div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px] xl:grid-cols-[minmax(0,1fr)_410px]">
      <div class="min-w-0">
        <div class="sp-frame">
          <div id="sp-player"></div>
        </div>

        <div class="mt-5">
          <p class="font-mono text-[12px] text-muted">
            Episode <span id="sp-n" class="tc-text tabular-nums">1</span> of {items.length} · {v.creator}
          </p>
          <h1 id="sp-title" class="mt-1.5 text-[clamp(1.25rem,2.4vw,1.6rem)] font-semibold leading-snug tracking-[-0.02em]">{items[0].t}</h1>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <button id="sp-prev" class="sp-btn press" aria-label="Previous episode">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg>
              Prev
            </button>
            <button id="sp-next" class="sp-btn sp-btn-main press" aria-label="Next episode">
              Next
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z" /></svg>
            </button>
            <button id="sp-done" class="vwatch press" aria-pressed="false">Mark watched</button>
            <label class="sp-switch ml-auto">
              <input id="sp-auto" type="checkbox" checked />
              <span aria-hidden="true"></span>
              Autoplay next
            </label>
          </div>
        </div>
      </div>

      <!-- Below the sidebar on small screens, under the player on large ones, like YouTube. -->
      <section class="sp-about order-3 min-w-0 self-start rounded-2xl border border-line bg-surface p-5 lg:order-none lg:col-start-1 lg:row-start-2" aria-label="About this series">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] text-muted">
          <span>{total} episodes</span>
          <span aria-hidden="true">·</span>
          <span>{totalLength(items)}{total > items.length ? '+' : ''}</span>
          <span aria-hidden="true">·</span>
          <span class="vlevel" data-level={v.level}>{v.level}</span>
        </p>
        <h2 class="mt-2 text-[1.15rem] font-semibold tracking-[-0.015em]">
          {v.title}
        </h2>
        <p class="mt-2 text-[14.5px] leading-relaxed text-[var(--body)]">{v.why}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] font-medium">
          <a href={lessonHref(pair.id)} class="tc-text hover:underline">Pairs with {pair.number} {pair.title} →</a>
          <a id="sp-yt" href={watchUrl(v)} target="_blank" rel="noopener" class="text-muted hover:text-fg">Open on YouTube ↗</a>
        </div>
      </section>

      <aside class="sp-side lg:col-start-2 lg:row-span-2 lg:row-start-1" aria-label="Episodes">
        <div class="border-b border-line p-4">
          <p class="truncate text-[15px] font-semibold tracking-[-0.01em]">{v.title}</p>
          <p class="mt-0.5 truncate font-mono text-[12px] text-muted">{v.creator}</p>
          <div class="mt-3 flex items-center gap-3">
            <span class="bar block flex-1"><span id="sp-bar" class="block" style="width:0%"></span></span>
            <span class="font-mono text-[12px] tabular-nums text-muted"><span id="sp-count">0</span> / {items.length}</span>
          </div>
          {
            items.length > 12 && (
              <input
                id="sp-filter"
                type="search"
                placeholder={`Filter ${items.length} episodes…`}
                class="mt-3 w-full rounded-md border border-line bg-bg px-3 py-1.5 text-[13px] placeholder:text-muted focus:border-fg/30 focus:outline-none"
              />
            )
          }
        </div>
        <ol id="sp-list" class="scroll-thin relative min-h-0 flex-1 overflow-y-auto p-2">
          {
            items.map((e, i) => (
              <li>
                <button class="sp-item" data-i={i} data-v={e.v}>
                  <span class="sp-idx font-mono tabular-nums">{i + 1}</span>
                  <span class="sp-thumb">
                    <img src={`https://i.ytimg.com/vi/${e.v}/mqdefault.jpg`} alt="" loading="lazy" decoding="async" width="160" height="90" />
                    {e.d && <span class="sp-len">{e.d}</span>}
                    <span class="sp-tick" aria-hidden="true">Watched</span>
                  </span>
                  <span class="sp-name">{e.t}</span>
                </button>
              </li>
            ))
          }
        </ol>
        {
          total > items.length && (
            <a href={watchUrl(v)} target="_blank" rel="noopener" class="block border-t border-line px-4 py-3 text-[12.5px] text-muted hover:text-fg">
              Showing the first {items.length} of {total}. See all on YouTube ↗
            </a>
          )
        }
      </aside>
    </div>
  </div>
  <script is:inline type="application/json" id="sp-data" set:html={JSON.stringify(data)} />
</Layout>

<script>
  import { onPage } from '../../lib/page';
  import { loadEpisodes, saveEpisode } from '../../lib/videos';

  // Minimal surface of the YouTube IFrame Player API that this page uses.
  interface YTPlayer {
    loadVideoById(id: string): void;
    cueVideoById(id: string): void;
    destroy(): void;
  }
  type YTNamespace = { Player: new (el: HTMLElement, opts: object) => YTPlayer; PlayerState: { ENDED: number } };
  type YTWindow = Window & { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void; __ytReady?: Promise<YTNamespace> };

  // Load the API script once per visit. View transitions keep the window, so later pages reuse it.
  function loadYT(): Promise<YTNamespace> {
    const w = window as YTWindow;
    w.__ytReady ??= new Promise((resolve, reject) => {
      if (w.YT?.Player) return resolve(w.YT);
      w.onYouTubeIframeAPIReady = () => resolve(w.YT!);
      const s = document.createElement('script');
      s.src = 'https://www.youtube.com/iframe_api';
      s.onerror = reject;
      document.head.append(s);
    });
    return w.__ytReady;
  }

  const AUTO_KEY = 'sd-autoplay';

  onPage(() => {
    const dataEl = document.getElementById('sp-data');
    const mount = document.getElementById('sp-player');
    if (!dataEl || !mount || mount.dataset.ready) return;
    mount.dataset.ready = '1';

    const { pl, items } = JSON.parse(dataEl.textContent!) as { pl: string; items: [string, string][] };
    const $ = (id: string) => document.getElementById(id)!;
    const list = $('sp-list');
    const buttons = [...list.querySelectorAll<HTMLButtonElement>('.sp-item')];
    const auto = $('sp-auto') as HTMLInputElement;
    let player: YTPlayer | null = null;
    let fallback: HTMLIFrameElement | null = null;

    try {
      auto.checked = localStorage.getItem(AUTO_KEY) !== '0';
    } catch {}

    const fromUrl = new URL(location.href).searchParams.get('v');
    const saved = loadEpisodes()[pl];
    let cur = Math.max(0, items.findIndex(([id]) => id === (fromUrl ?? saved?.last)));

    const paint = () => {
      const done = new Set(loadEpisodes()[pl]?.done ?? []);
      for (const b of buttons) {
        b.toggleAttribute('data-done', done.has(b.dataset.v!));
        const active = Number(b.dataset.i) === cur;
        b.toggleAttribute('data-active', active);
        if (active) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      }
      const n = items.filter(([id]) => done.has(id)).length;
      $('sp-count').textContent = String(n);
      $('sp-bar').style.width = `${(n / items.length) * 100}%`;
      const on = done.has(items[cur][0]);
      $('sp-done').setAttribute('aria-pressed', String(on));
      $('sp-done').textContent = on ? '✓ Watched' : 'Mark watched';
      ($('sp-prev') as HTMLButtonElement).disabled = cur === 0;
      ($('sp-next') as HTMLButtonElement).disabled = cur === items.length - 1;
    };

    const go = (i: number, play: boolean) => {
      cur = Math.min(items.length - 1, Math.max(0, i));
      const [id, title] = items[cur];
      $('sp-n').textContent = String(cur + 1);
      $('sp-title').textContent = title;
      ($('sp-yt') as HTMLAnchorElement).href = `https://www.youtube.com/watch?v=${id}&list=${pl}`;
      if (player) {
        if (play) player.loadVideoById(id);
        else player.cueVideoById(id);
      } else if (fallback) {
        fallback.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0${play ? '&autoplay=1' : ''}`;
      }
      saveEpisode(pl, { last: id });
      const url = new URL(location.href);
      url.searchParams.set('v', id);
      history.replaceState(history.state, '', url);
      // Scroll the list, not the page, so the current episode stays in view.
      const b = buttons[cur];
      list.scrollTo({ top: b.offsetTop - list.clientHeight / 2 + b.clientHeight / 2, behavior: 'smooth' });
      paint();
    };

    loadYT()
      .then((YT) => {
        if (!mount.isConnected) return;
        player = new YT.Player(mount, {
          host: 'https://www.youtube-nocookie.com',
          videoId: items[cur][0],
          playerVars: { rel: 0, playsinline: 1 },
          events: {
            onStateChange: (e: { data: number }) => {
              if (e.data !== YT.PlayerState.ENDED) return;
              saveEpisode(pl, { done: [items[cur][0], true] });
              if (auto.checked && cur < items.length - 1) go(cur + 1, true);
              else paint();
            },
          },
        });
      })
      .catch(() => {
        // API blocked (ad blocker, offline script): plain embed, no auto-advance.
        fallback = document.createElement('iframe');
        fallback.title = 'Video player';
        fallback.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        fallback.allowFullscreen = true;
        mount.replaceWith(fallback);
        go(cur, false);
      });

    buttons.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.i), true)));
    $('sp-prev').addEventListener('click', () => go(cur - 1, true));
    $('sp-next').addEventListener('click', () => go(cur + 1, true));
    $('sp-done').addEventListener('click', () => {
      saveEpisode(pl, { done: [items[cur][0], $('sp-done').getAttribute('aria-pressed') !== 'true'] });
      paint();
    });
    auto.addEventListener('change', () => {
      try {
        localStorage.setItem(AUTO_KEY, auto.checked ? '1' : '0');
      } catch {}
    });
    document.getElementById('sp-filter')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      buttons.forEach((b, i) => (b.parentElement!.hidden = !!q && !items[i][1].toLowerCase().includes(q)));
    });

    go(cur, false);
  });
</script>
