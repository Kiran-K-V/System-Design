---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import { videos, thumbUrl, seriesHref, type Video } from '../lib/videos';
import { loadSyllabus } from '../lib/lessons';
import { tracks, trackIds } from '../lib/tracks';

const { flat } = await loadSyllabus();
const pairOf = (v: Video) => {
  const l = flat.find((x) => x.id === v.pairs);
  if (!l) throw new Error(`videos.ts: "${v.title}" pairs with unknown lesson ${v.pairs}`);
  return l;
};

const sections = trackIds.map((t) => ({
  track: tracks[t],
  start: videos.filter((v) => v.track === t && v.tier === 'start'),
  deeper: videos.filter((v) => v.track === t && v.tier === 'deeper'),
}));
// Hero pick for a first visit. Once a series is started, the script swaps in the most recent one.
const featured = videos.find((v) => v.yt === 'PLZHQObOWTQDNU6R1_67000Dx_ZCJB-3pi')!;
---

<Layout title="Videos" zone="cinema" description="Hand-picked lectures and talks on system design and AI, each paired with a lesson. Watch them here and pick up where you left off.">
  <div class="mx-auto max-w-[1120px]">
    <section class="grid items-center gap-8 md:grid-cols-2 md:gap-12" style="--tc: var(--c-backend)">
      <div>
        <h1 class="text-[clamp(2.1rem,4vw,3rem)] font-semibold leading-[1.06] tracking-[-0.04em]">Watch the lectures engineers learn from.</h1>
        <p class="mt-5 max-w-[42ch] text-[1.05rem] leading-relaxed text-muted">
          {videos.length} hand-picked series and talks, each paired with a lesson. Your place in every series is saved.
        </p>
        <a id="v-cta" href={seriesHref(featured)} class="press mt-8 inline-flex items-center gap-2 rounded-full bg-fg px-5 py-2.5 text-sm font-semibold text-bg hover:opacity-90">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
          <span id="v-cta-label">Start watching</span>
        </a>
      </div>
      <figure class="vcard vc-hero m-0">
        <a id="v-hero" href={seriesHref(featured)} class="vthumb" aria-label={`Open ${featured.title} by ${featured.creator}`}>
          <img id="v-hero-img" src={thumbUrl(featured)} alt="" loading="eager" decoding="async" width="480" height="270" />
          <span class="vplay" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
        </a>
        <figcaption class="text-[13.5px] text-muted">
          <span id="v-hero-label">Start with</span> <span id="v-hero-title" class="font-medium text-fg">{featured.title}</span> by <span id="v-hero-creator">{featured.creator}</span>
        </figcaption>
      </figure>
    </section>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4">
      <div class="flex gap-1 rounded-full border border-line p-1 text-[13px] font-medium" role="group" aria-label="Show track">
        <button class="vchip press" data-filter="all" aria-pressed="true">All</button>
        {trackIds.map((t) => <button class="vchip press" data-filter={t} aria-pressed="false">{tracks[t].short}</button>)}
      </div>
      <p class="text-[13px] tabular-nums text-muted"><span id="v-count" class="font-medium text-fg">0</span> of {videos.length} finished</p>
    </div>

    {
      sections.map(({ track, start, deeper }) => (
        <section class="vsection mt-10 border-t border-line pt-10" data-section={track.id} aria-labelledby={`v-${track.id}`}>
          <h2 id={`v-${track.id}`} class="text-[1.75rem] font-semibold tracking-[-0.03em]">
            {track.short}
          </h2>

          <h3 class="mt-6 text-[14px] font-medium text-muted">Start here</h3>
          <div class="mt-4">
            <VideoCard v={start[0]} pair={pairOf(start[0])} variant="lead" />
          </div>
          <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2">
            {start.slice(1).map((v) => <VideoCard v={v} pair={pairOf(v)} variant="side" />)}
          </div>

          <h3 class="mt-14 text-[14px] font-medium text-muted">Go deeper</h3>
          <div class="mt-4 grid gap-x-10 gap-y-7 md:grid-cols-2">
            {deeper.map((v) => <VideoCard v={v} pair={pairOf(v)} variant="row" />)}
          </div>
        </section>
      ))
    }

    <p class="mt-16 border-t border-line pt-6 text-[13px] leading-relaxed text-muted">
      Videos play from YouTube in privacy-enhanced mode. All credit goes to the creators: open a video on YouTube to like, comment or subscribe. Your progress stays in this browser only.
    </p>
  </div>

  <dialog id="vplayer" class="vplayer" aria-labelledby="vp-title">
    <div class="vp-frame">
      <iframe
        id="vp-iframe"
        title="Video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3 p-5">
      <div class="min-w-0 flex-1 basis-[280px]">
        <p id="vp-creator" class="font-mono text-[12px] text-muted"></p>
        <h2 id="vp-title" class="mt-1 text-[1.2rem] font-semibold leading-snug tracking-[-0.015em]"></h2>
        <p id="vp-why" class="mt-2 text-[14px] leading-relaxed text-muted"></p>
        <a id="vp-pair" class="mt-3 inline-block text-[13px] font-medium text-accent hover:underline"></a>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <button id="vp-watched" class="vwatch press" aria-pressed="false">Mark watched</button>
        <a id="vp-yt" class="press rounded-md border border-line px-3 py-1.5 text-[13px] font-medium hover:border-fg/30" target="_blank" rel="noopener">Open on YouTube ↗</a>
        <button id="vp-close" class="press rounded-md bg-fg px-3 py-1.5 text-[13px] font-medium text-bg hover:opacity-90" aria-label="Close player">Close</button>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  import { onPage, once } from '../lib/page';
  import { loadWatched, setWatched, loadEpisodes } from '../lib/videos';

  const FILTER_KEY = 'sd-videos-filter';

  onPage(() => {
    const dlg = document.getElementById('vplayer') as HTMLDialogElement | null;
    if (!dlg) return;
    const iframe = document.getElementById('vp-iframe') as HTMLIFrameElement;
    const $ = (id: string) => document.getElementById(id)!;
    const cards = [...document.querySelectorAll<HTMLElement>('.vsection .vcard')];
    let current = '';

    const paint = () => {
      const w = loadWatched();
      const eps = loadEpisodes();
      let n = 0;
      for (const c of cards) {
        const yt = c.dataset.yt!;
        let on: boolean;
        if (c.dataset.kind === 'series') {
          const total = Number(c.dataset.eps);
          const done = eps[yt]?.done.length ?? 0;
          on = done >= total;
          c.querySelector<HTMLElement>('.vprog > span')!.style.width = `${(done / total) * 100}%`;
          const cta = c.querySelector<HTMLElement>('[data-series-cta]')!;
          cta.textContent = on ? 'Watch again' : done ? `Continue ${done}/${total}` : 'Start';
          cta.toggleAttribute('data-started', done > 0 && !on);
        } else {
          on = w.has(yt);
          const b = c.querySelector<HTMLButtonElement>('[data-watch-toggle]')!;
          b.setAttribute('aria-pressed', String(on));
          b.textContent = on ? '✓ Watched' : 'Mark watched';
        }
        c.toggleAttribute('data-done', on);
        if (on) n++;
      }
      $('v-count').textContent = String(n);
      if (current) {
        const on = w.has(current);
        $('vp-watched').setAttribute('aria-pressed', String(on));
        $('vp-watched').textContent = on ? '✓ Watched' : 'Mark watched';
      }
    };

    const applyFilter = (f: string) => {
      document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      document.querySelectorAll<HTMLElement>('.vsection').forEach((s) => (s.hidden = f !== 'all' && s.dataset.section !== f));
    };

    // Links from a track (?track=ai) pick the filter; ?play=<id> opens a talk's player.
    const params = new URL(location.href).searchParams;
    let saved = 'all';
    try {
      saved = localStorage.getItem(FILTER_KEY) ?? 'all';
    } catch {}
    const linked = params.get('track');
    if (linked === 'backend' || linked === 'ai') saved = linked;
    applyFilter(saved);
    paint();

    // Hero: continue the series opened most recently, if any.
    const recent = Object.entries(loadEpisodes())
      .filter(([, s]) => s.last && s.at)
      .sort(([, a], [, b]) => b.at! - a.at!)[0];
    const card = recent && cards.find((c) => c.dataset.yt === recent[0] && c.dataset.href);
    if (recent && card) {
      const href = `${card.dataset.href}?v=${recent[1].last}`;
      ($('v-hero') as HTMLAnchorElement).href = href;
      ($('v-cta') as HTMLAnchorElement).href = href;
      ($('v-hero-img') as HTMLImageElement).src = `https://i.ytimg.com/vi/${recent[1].last}/hqdefault.jpg`;
      $('v-hero-label').textContent = 'Continue';
      $('v-hero-title').textContent = card.dataset.title!;
      $('v-hero-creator').textContent = card.dataset.creator!;
      $('v-cta-label').textContent = 'Continue watching';
    }

    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => {
      if (!once(b)) return;
      b.addEventListener('click', () => {
        applyFilter(b.dataset.filter!);
        try {
          localStorage.setItem(FILTER_KEY, b.dataset.filter!);
        } catch {}
      });
    });

    for (const c of cards) {
      const play = c.querySelector<HTMLElement>('[data-play]');
      const toggle = c.querySelector<HTMLElement>('[data-watch-toggle]');
      if (play && once(play)) {
        play.addEventListener('click', () => {
          const d = play.dataset;
          current = c.dataset.yt!;
          dlg.dataset.track = c.closest<HTMLElement>('.vsection')?.dataset.section;
          $('vp-title').textContent = d.title!;
          $('vp-creator').textContent = d.creator!;
          $('vp-why').textContent = d.why!;
          ($('vp-pair') as HTMLAnchorElement).href = d.pairHref!;
          $('vp-pair').textContent = `Pairs with ${d.pairLabel} →`;
          ($('vp-yt') as HTMLAnchorElement).href = d.watch!;
          iframe.src = d.embed!;
          paint();
          dlg.showModal();
        });
      }
      if (toggle && once(toggle)) {
        toggle.addEventListener('click', () => {
          setWatched(c.dataset.yt!, toggle.getAttribute('aria-pressed') !== 'true');
          paint();
        });
      }
    }

    if (once(dlg)) {
      // Stop playback when the player closes, by any route (button, Esc, backdrop).
      dlg.addEventListener('close', () => {
        iframe.src = 'about:blank';
        current = '';
      });
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
      $('vp-close').addEventListener('click', () => dlg.close());
      $('vp-pair').addEventListener('click', () => dlg.close());
      $('vp-watched').addEventListener('click', () => {
        if (!current) return;
        setWatched(current, $('vp-watched').getAttribute('aria-pressed') !== 'true');
        paint();
      });
    }

    const play = params.get('play');
    if (play) {
      const url = new URL(location.href);
      url.searchParams.delete('play');
      history.replaceState(history.state, '', url);
      cards.find((c) => c.dataset.yt === play)?.querySelector<HTMLElement>('[data-play]')?.click();
    }
  });
</script>
