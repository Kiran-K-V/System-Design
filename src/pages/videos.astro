---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import { videos, type Video } from '../lib/videos';
import { loadSyllabus } from '../lib/lessons';
import { tracks, trackIds } from '../lib/tracks';

const { flat } = await loadSyllabus();
const pairOf = (v: Video) => {
  const l = flat.find((x) => x.id === v.pairs);
  if (!l) throw new Error(`videos.ts: "${v.title}" pairs with unknown lesson ${v.pairs}`);
  return l;
};

const sections = trackIds.map((t) => ({
  track: tracks[t],
  start: videos.filter((v) => v.track === t && v.tier === 'start'),
  deeper: videos.filter((v) => v.track === t && v.tier === 'deeper'),
}));
---

<Layout title="Videos" description="Hand-picked videos and lecture series that have taught system design and AI to learners across the world. Watch them here, each paired with a lesson.">
  <div class="mx-auto max-w-[1040px]">
    <p class="flex items-center gap-3 font-mono text-[12px] tracking-[0.02em] text-muted">
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      Videos · the best of the rest
    </p>
    <h1 class="mt-6 max-w-[17ch] text-[clamp(2.4rem,6vw,4rem)] font-semibold leading-[0.98] tracking-[-0.04em]">
      Learn from the teachers who <em class="font-display text-[1.12em] font-normal italic leading-[0.8] tracking-[-0.015em] text-accent">taught the world.</em>
    </h1>
    <p class="mt-6 max-w-[60ch] text-[1.05rem] leading-[1.65] text-muted">
      {videos.length} videos and lecture series that learners recommend again and again. Each one pairs with a lesson. Series open in their own player with every episode in a sidebar. Your progress is saved, so you can pick up where you left off.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-y border-line py-4">
      <div class="flex gap-1 rounded-lg border border-line bg-surface p-1 text-[13px] font-medium" role="group" aria-label="Show track">
        <button class="vchip press" data-filter="all" aria-pressed="true">All</button>
        {trackIds.map((t) => <button class="vchip press" data-filter={t} aria-pressed="false">{tracks[t].short}</button>)}
      </div>
      <div class="flex min-w-[200px] flex-1 items-center justify-end gap-3 sm:flex-none">
        <span class="bar block w-40"><span id="v-bar" class="block" style="width:0%"></span></span>
        <span class="font-mono text-[12px] tabular-nums text-muted"><span id="v-count">0</span> / {videos.length} finished</span>
      </div>
    </div>

    {
      sections.map(({ track, start, deeper }) => (
        <section class="vsection mt-14" data-section={track.id} aria-labelledby={`v-${track.id}`}>
          <h2 id={`v-${track.id}`} class="text-[1.6rem] font-semibold tracking-[-0.03em]">
            <span class="tc-text font-display text-[1.25em] font-normal italic leading-[0.8]">{track.short}</span> videos
          </h2>

          <p class="mt-6 flex items-center gap-3 font-mono text-[12px] text-muted">
            <span class="h-px w-8" style="background: var(--tc)" aria-hidden="true"></span>
            start here, in this order
          </p>
          <div class="mt-4 grid gap-5 md:grid-cols-3">
            {start.map((v, i) => <VideoCard v={v} pair={pairOf(v)} n={i + 1} />)}
          </div>

          <p class="mt-10 flex items-center gap-3 font-mono text-[12px] text-muted">
            <span class="h-px w-8" style="background: var(--tc)" aria-hidden="true"></span>
            go deeper
          </p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {deeper.map((v) => <VideoCard v={v} pair={pairOf(v)} />)}
          </div>
        </section>
      ))
    }

    <p class="mt-16 border-t border-line pt-6 text-[13px] leading-relaxed text-muted">
      Videos play from YouTube in privacy-enhanced mode. All credit goes to the creators: open a video on YouTube to like, comment or subscribe. Your progress stays in this browser only.
    </p>
  </div>

  <dialog id="vplayer" class="vplayer" aria-labelledby="vp-title">
    <div class="vp-frame">
      <iframe
        id="vp-iframe"
        title="Video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
    <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3 p-5">
      <div class="min-w-0 flex-1 basis-[280px]">
        <p id="vp-creator" class="font-mono text-[12px] text-muted"></p>
        <h2 id="vp-title" class="mt-1 text-[1.2rem] font-semibold leading-snug tracking-[-0.015em]"></h2>
        <p id="vp-why" class="mt-2 text-[14px] leading-relaxed text-muted"></p>
        <a id="vp-pair" class="mt-3 inline-block text-[13px] font-medium text-accent hover:underline"></a>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <button id="vp-watched" class="vwatch press" aria-pressed="false">Mark watched</button>
        <a id="vp-yt" class="press rounded-md border border-line px-3 py-1.5 text-[13px] font-medium hover:border-fg/30" target="_blank" rel="noopener">Open on YouTube ↗</a>
        <button id="vp-close" class="press rounded-md bg-fg px-3 py-1.5 text-[13px] font-medium text-bg hover:opacity-90" aria-label="Close player">Close</button>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  import { onPage, once } from '../lib/page';
  import { loadWatched, setWatched, loadEpisodes } from '../lib/videos';

  const FILTER_KEY = 'sd-videos-filter';

  onPage(() => {
    const dlg = document.getElementById('vplayer') as HTMLDialogElement | null;
    if (!dlg) return;
    const iframe = document.getElementById('vp-iframe') as HTMLIFrameElement;
    const $ = (id: string) => document.getElementById(id)!;
    const cards = [...document.querySelectorAll<HTMLElement>('.vcard')];
    let current = '';

    const paint = () => {
      const w = loadWatched();
      const eps = loadEpisodes();
      let n = 0;
      for (const c of cards) {
        const yt = c.dataset.yt!;
        let on: boolean;
        if (c.dataset.kind === 'series') {
          const total = Number(c.dataset.eps);
          const done = eps[yt]?.done.length ?? 0;
          on = done >= total;
          c.querySelector<HTMLElement>('.vprog > span')!.style.width = `${(done / total) * 100}%`;
          const cta = c.querySelector<HTMLElement>('[data-series-cta]')!;
          cta.textContent = on ? 'Watch again' : done ? `Continue · ${done}/${total}` : 'Start series';
          cta.toggleAttribute('data-started', done > 0 && !on);
        } else {
          on = w.has(yt);
          const b = c.querySelector<HTMLButtonElement>('[data-watch-toggle]')!;
          b.setAttribute('aria-pressed', String(on));
          b.textContent = on ? '✓ Watched' : 'Mark watched';
        }
        c.toggleAttribute('data-done', on);
        if (on) n++;
      }
      $('v-count').textContent = String(n);
      $('v-bar').style.width = `${(n / cards.length) * 100}%`;
      if (current) {
        const on = w.has(current);
        $('vp-watched').setAttribute('aria-pressed', String(on));
        $('vp-watched').textContent = on ? '✓ Watched' : 'Mark watched';
      }
    };

    const applyFilter = (f: string) => {
      document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      document.querySelectorAll<HTMLElement>('.vsection').forEach((s) => (s.hidden = f !== 'all' && s.dataset.section !== f));
    };

    let saved = 'all';
    try {
      saved = localStorage.getItem(FILTER_KEY) ?? 'all';
    } catch {}
    applyFilter(saved);
    paint();

    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => {
      if (!once(b)) return;
      b.addEventListener('click', () => {
        applyFilter(b.dataset.filter!);
        try {
          localStorage.setItem(FILTER_KEY, b.dataset.filter!);
        } catch {}
      });
    });

    for (const c of cards) {
      const play = c.querySelector<HTMLElement>('[data-play]');
      const toggle = c.querySelector<HTMLElement>('[data-watch-toggle]');
      if (play && once(play)) {
        play.addEventListener('click', () => {
          const d = play.dataset;
          current = c.dataset.yt!;
          dlg.dataset.track = c.closest<HTMLElement>('.vsection')?.dataset.section;
          $('vp-title').textContent = d.title!;
          $('vp-creator').textContent = d.creator!;
          $('vp-why').textContent = d.why!;
          ($('vp-pair') as HTMLAnchorElement).href = d.pairHref!;
          $('vp-pair').textContent = `Pairs with ${d.pairLabel} →`;
          ($('vp-yt') as HTMLAnchorElement).href = d.watch!;
          iframe.src = d.embed!;
          paint();
          dlg.showModal();
        });
      }
      if (toggle && once(toggle)) {
        toggle.addEventListener('click', () => {
          setWatched(c.dataset.yt!, toggle.getAttribute('aria-pressed') !== 'true');
          paint();
        });
      }
    }

    if (once(dlg)) {
      // Stop playback when the player closes, by any route (button, Esc, backdrop).
      dlg.addEventListener('close', () => {
        iframe.src = 'about:blank';
        current = '';
      });
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
      $('vp-close').addEventListener('click', () => dlg.close());
      $('vp-pair').addEventListener('click', () => dlg.close());
      $('vp-watched').addEventListener('click', () => {
        if (!current) return;
        setWatched(current, $('vp-watched').getAttribute('aria-pressed') !== 'true');
        paint();
      });
    }
  });
</script>
