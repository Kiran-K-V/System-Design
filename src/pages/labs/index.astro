---
import Layout from '../../layouts/Layout.astro';
import { labs, labHref, codespaceUrl } from '../../lib/labs';
import { loadSyllabus } from '../../lib/lessons';
import { lessonHref } from '../../lib/tracks';

const { flat } = await loadSyllabus();
const lessonOf = (id: string) => flat.find((l) => l.id === id);
---

<Layout title="Labs" description="Hands-on labs: run real Postgres, Redis, and Kafka, break them, fix them, and prove the fix with a script.">
  <div class="mx-auto max-w-[700px]">
    <h1 class="text-3xl font-bold tracking-tight">Labs</h1>
    <p class="mt-2 text-muted">
      Lessons show how systems work. Labs make you fix one. Each lab runs real software on your machine, breaks it under load, and checks your fix with a script.
      You need Docker, or <a href={codespaceUrl} class="font-medium text-accent hover:underline" target="_blank" rel="noopener">GitHub Codespaces</a>.
    </p>

    <ul class="mt-10 divide-y divide-line border-y border-line">
      {
        labs.map((lab) => {
          const l = lessonOf(lab.lesson);
          return (
            <li class="py-5" data-lab={lab.id}>
              <a href={labHref(lab)} class="group block">
                <p class="flex items-baseline justify-between gap-3 font-mono text-[12px] text-muted">
                  <span>{lab.id} · {lab.minutes} min</span>
                  <span class="lab-status hidden text-ok">✓ passed</span>
                </p>
                <p class="mt-1 text-lg font-medium tracking-tight group-hover:text-accent">{lab.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-muted">{lab.goal}</p>
              </a>
              {l && (
                <a href={lessonHref(l.id)} class="mt-2 inline-block text-[13px] text-muted hover:text-fg">
                  Practises {l.number} {l.title} →
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
    <p class="mt-6 text-sm text-muted">More labs are coming: indexing, Tatkal overselling, replica lag, idempotent payments, rate limits, retry storms, duplicate events, and poison messages.</p>
  </div>
</Layout>

<script>
  import { onPage } from '../../lib/page';
  import { loadLabs } from '../../lib/labs';
  onPage(() => {
    const done = loadLabs();
    document.querySelectorAll<HTMLElement>('[data-lab]').forEach((el) => {
      el.querySelector('.lab-status')?.classList.toggle('hidden', !done[el.dataset.lab!]?.done);
    });
  });
</script>
