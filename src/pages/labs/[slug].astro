---
import Layout from '../../layouts/Layout.astro';
import LabRunner from '../../components/lesson/LabRunner';
import { labs, codespaceUrl, type Lab } from '../../lib/labs';
import { loadSyllabus } from '../../lib/lessons';
import { lessonHref } from '../../lib/tracks';

export function getStaticPaths() {
  return labs.map((lab) => ({ params: { slug: lab.slug }, props: { lab } }));
}

const { lab } = Astro.props as { lab: Lab };
const { flat } = await loadSyllabus();
const lesson = flat.find((l) => l.id === lab.lesson);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={lab.title} description={lab.goal} track="backend">
  <article class="mx-auto max-w-[700px]">
    <header class="border-b border-line pb-8">
      <nav class="font-mono text-[12px] text-muted" aria-label="Breadcrumb">
        <a href={`${base}/labs/`} class="hover:text-fg">Labs</a>
        <span aria-hidden="true"> / </span>
        <span>{lab.id}</span>
      </nav>
      <p class="mt-10 font-display text-[clamp(4rem,9vw,6rem)] italic leading-[0.75] tracking-[-0.02em] text-accent" aria-hidden="true">{lab.id}</p>
      <h1 class="mt-4 text-[clamp(2.4rem,5.5vw,3.4rem)] font-semibold leading-[1.02] tracking-[-0.04em]">{lab.title}</h1>
      <p class="mt-5 max-w-[58ch] text-[1.125rem] leading-[1.6] text-muted">{lab.goal}</p>
      <p class="mt-6 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-[12px] text-muted">
        <span>about {lab.minutes} min</span>
        {lab.stack.map((s) => (<><span aria-hidden="true">·</span><span>{s}</span></>))}
      </p>
      {
        lesson && (
          <p class="mt-4 text-sm">
            <span class="text-muted">Read first: </span>
            <a href={lessonHref(lesson.id)} class="font-medium underline decoration-line underline-offset-4 hover:decoration-accent">
              {lesson.number} {lesson.title}
            </a>
          </p>
        )
      }
    </header>

    <LabRunner
      client:load
      id={lab.id}
      dir={lab.dir}
      predict={lab.predict}
      steps={lab.steps}
      rules={lab.rules}
      hints={lab.hints}
      reflect={lab.reflect}
      codespaceUrl={codespaceUrl}
    />
  </article>
</Layout>
