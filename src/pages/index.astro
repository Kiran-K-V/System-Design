---
import Layout from '../layouts/Layout.astro';
import TrackBridge, { bridges } from '../components/lesson/TrackBridge';
import { loadSyllabus } from '../lib/lessons';
import { tracks, trackHref, lessonHref, trackIds } from '../lib/tracks';
import { videos, thumbUrl, seriesHref } from '../lib/videos';

// Puzzle bank: every Diagnose and Ballpark item in a written lesson, pulled from the MDX source at build time.
const raw = import.meta.glob<string>('/src/content/lessons/**/*.mdx', { query: '?raw', import: 'default', eager: true });

const syl = await loadSyllabus();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstWritten = syl.flat.find((l) => l.written);

const cards = trackIds.map((id) => {
  const t = tracks[id];
  const s = syl.tracks[id];
  const ready = s.flat.filter((l) => l.written);
  return { t, s, ready, total: s.flat.length };
});

// Data the page script needs: ready lessons per track in order, and the label of each.
const data = {
  lessons: Object.fromEntries(syl.flat.filter((l) => l.written).map((l) => [l.id, [l.number, l.title, l.track]])),
  tracks: Object.fromEntries(cards.map((c) => [c.t.id, { ready: c.ready.map((l) => l.id), name: c.t.short }])),
  hrefs: Object.fromEntries(syl.flat.filter((l) => l.written).map((l) => [l.id, lessonHref(l.id)])),
  start: firstWritten ? { number: firstWritten.number, title: firstWritten.title, href: lessonHref(firstWritten.id) } : null,
};

const attr = (chunk: string, name: string) => chunk.match(new RegExp(`\\b${name}="([^"]*)"`))?.[1];
const puzzles = syl.flat
  .filter((l) => l.written)
  .flatMap((l) => {
    const src = raw[`/src/content/lessons/${l.id}.mdx`] ?? '';
    return [...src.matchAll(/^<(Diagnose|Ballpark)\b/gm)].flatMap((m, i) => {
      const chunk = src.slice(m.index!, m.index! + 900);
      const title = attr(chunk, 'title');
      const scenario = attr(chunk, 'scenario');
      if (!title || !scenario) return [];
      return [{ key: `${l.id}#${i}`, kind: m[1] === 'Diagnose' ? 'Diagnose' : 'Ballpark', title, scenario, number: l.number, lesson: l.title, href: lessonHref(l.id) }];
    });
  });
const hubData = { ...data, puzzles };

// Three faces of the Videos section for the home band: one per subject, start-here picks.
const featured = ['PLZHQObOWTQDNU6R1_67000Dx_ZCJB-3pi', 'PLAqhIrjkxbuWI23v9cThsA9GvCAUhRvKZ', 'PLeKd45zvjcDFUEv_ohr_HdUFe97RItdiB'].map(
  (yt) => videos.find((v) => v.yt === yt)!,
);

const shape = ['The problem', 'The naive way', 'The mechanism', 'The numbers', 'Trade-offs', 'Interview lens', 'Check yourself'];
---

<Layout title="Uptime">
  <div class="mx-auto max-w-[1040px]">
    <p class="flex items-center gap-3 font-mono text-[12px] tracking-[0.02em] text-muted">
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      Uptime · two tracks, one foundation
    </p>
    <h1 class="mt-6 max-w-[15ch] text-[clamp(2.75rem,7.5vw,5rem)] font-semibold leading-[0.95] tracking-[-0.045em]">
      Become the engineer who <em class="font-display text-[1.12em] font-normal italic leading-[0.8] tracking-[-0.015em] text-accent">knows&nbsp;stuff.</em>
    </h1>
    <p class="mt-7 max-w-[56ch] text-[1.075rem] leading-[1.65] text-muted">
      Learn backend system design from first principles, then the AI systems built on top of it.
    </p>

    <a
      id="resume"
      href={firstWritten ? lessonHref(firstWritten.id) : '#'}
      class="press invisible mt-10 flex min-h-[4.25rem] items-center gap-4 rounded-xl border border-line bg-surface px-5 py-3 hover:border-fg/30"
    >
      <span class="min-w-0 flex-1">
        <span class="block truncate text-[15px] font-medium"><span id="resume-label" class="text-muted">Start here:</span> <span id="resume-title">{firstWritten ? `${firstWritten.number} ${firstWritten.title}` : ''}</span></span>
        <span class="mt-1.5 flex items-center gap-3">
          <span class="bar block w-40 max-w-[50%]"><span id="resume-bar" class="block"></span></span>
          <span id="resume-meta" class="font-mono text-[12px] tabular-nums text-muted"></span>
        </span>
      </span>
      <svg class="shrink-0" width="16" height="16" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" /></svg>
    </a>

    <section class="mt-10 grid gap-5 md:grid-cols-2" aria-label="Tracks">
      {
        cards.map(({ t, s, ready, total }) => {
          const soon = ready.length === 0;
          return (
            <article class="track-card" data-track-card={t.id}>
              <div class="flex flex-col-reverse items-start gap-2 sm:flex-row sm:justify-between sm:gap-3">
                <h2 class="whitespace-nowrap text-[1.5rem] font-semibold leading-tight tracking-[-0.03em]"><span class="tc-text font-display text-[1.25em] font-normal italic leading-[0.8]">{t.short}</span> track</h2>
                {soon && <span class="track-chip shrink-0">Coming soon · outline ready</span>}
              </div>
              <p class="mt-1 text-[13px] font-medium text-muted">{t.name}</p>
              <p class="mt-3 text-[15px] leading-relaxed text-fg/85">{t.tagline}</p>
              <p class="mt-5 font-mono text-[12px] tabular-nums text-muted">{s.modules.length} modules · {total} lessons · {ready.length} ready</p>
              <div class="strip mt-2.5" role="img" aria-label={`${s.modules.length} modules, ${s.modules.filter((m) => m.lessons.some((l) => l.written)).length} with lessons ready`}>
                {s.modules.map((m) => {
                  const ids = m.lessons.filter((l) => l.written).map((l) => l.id);
                  return <span data-state={ids.length ? 'ready' : 'soon'} data-ids={JSON.stringify(ids)} title={`${m.label} ${m.title}`}></span>;
                })}
              </div>
              <ul class="mt-5 space-y-2 text-[14.5px] leading-snug">
                {
                  t.bullets.map((b) => (
                    <li class="flex gap-2.5"><span class="tc-text mt-[0.2em]" aria-hidden="true">→</span><span>{b}</span></li>
                  ))
                }
              </ul>
              <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 pt-1">
                <a href={trackHref(t.id)} class="press group inline-flex items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg hover:opacity-90">
                  {soon ? 'See the outline' : 'Open track'}
                  <svg class="transition-transform duration-200 group-hover:translate-x-0.5" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" /></svg>
                </a>
                {!soon && <a data-resume={t.id} href={trackHref(t.id)} class="press hidden text-sm font-medium underline decoration-line decoration-1 underline-offset-[6px] hover:decoration-current">Resume</a>}
              </div>
            </article>
          );
        })
      }
    </section>

    <section class="mt-20" aria-labelledby="watch-h">
      <h2 id="watch-h" class="flex items-center gap-3 font-mono text-[12px] font-normal text-muted">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        videos
      </h2>
      <div class="mt-6 grid items-start gap-6 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-10">
        <div>
          <p class="text-[1.5rem] font-semibold leading-tight tracking-[-0.03em]">Watch the lectures engineers learn from.</p>
          <p class="mt-3 max-w-[44ch] text-[15px] leading-relaxed text-muted">
            {videos.length} series and talks by 3Blue1Brown, Andrej Karpathy, Martin Kleppmann, MIT and others. Each one pairs with a lesson.
          </p>
          <a href={`${base}/videos/`} class="press mt-6 inline-flex items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg hover:opacity-90">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
            Open Videos
          </a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {
            featured.map((v, i) => (
              <a href={seriesHref(v)} class:list={['group block', i === 0 && 'col-span-2']}>
                <span class="block aspect-video overflow-hidden rounded-lg border border-line bg-surface">
                  <img src={thumbUrl(v)} alt="" loading="lazy" decoding="async" width="480" height="270" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                </span>
                <span class="mt-2 block truncate text-[13.5px] font-medium group-hover:text-accent">{v.title}</span>
                <span class="block truncate text-[12.5px] text-muted">{v.creator}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="bridge-h">
      <h2 id="bridge-h" class="flex items-center gap-3 font-mono text-[12px] font-normal text-muted">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        how the tracks connect
      </h2>
      <figure class="mt-6 hidden sm:block" aria-label="Backend modules feed the AI modules built on them">
        <div class="mx-auto max-w-[760px]"><TrackBridge /></div>
        <figcaption class="mt-3 text-center text-[13px] text-muted">AI lessons link back to the backend lesson they build on.</figcaption>
      </figure>
      <ul class="mt-5 space-y-2.5 text-[14.5px] leading-snug sm:hidden">
        {
          bridges.map((b) => (
            <li><span class="font-medium" style="color: var(--c-ai)">AI {b.ai}</span> builds on <span class="text-muted">{b.from.join(', ')}</span>.</li>
          ))
        }
        <li class="text-[13px] text-muted">AI lessons link back to the backend lesson they build on.</li>
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="daily-h">
      <h2 id="daily-h" class="flex items-center gap-3 font-mono text-[12px] font-normal text-muted">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        daily practice
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a href={`${base}/review/`} class="press rounded-xl border border-line bg-surface p-5 hover:border-fg/30">
          <p class="text-[13px] font-medium text-muted">Review due</p>
          <p class="mt-2 text-[2.25rem] font-semibold leading-none tracking-[-0.03em] tabular-nums"><span id="due-count">0</span></p>
          <p class="mt-2 text-[13px] text-muted">questions ready to revisit</p>
        </a>
        <div id="puzzle" class="rounded-xl border border-line bg-surface p-5">
          <p class="flex items-center justify-between gap-2 text-[13px] font-medium text-muted">Puzzle of the day <span id="puzzle-kind" class="font-mono text-[12px]"></span></p>
          {
            puzzles.length > 0 ? (
              <>
                <p id="puzzle-title" class="mt-2 text-[1.05rem] font-semibold leading-snug tracking-[-0.015em]">{puzzles[0].title}</p>
                <p id="puzzle-scenario" class="mt-1.5 line-clamp-3 text-[13px] leading-snug text-muted">{puzzles[0].scenario}</p>
                <a id="puzzle-link" href={puzzles[0].href} class="press mt-3 inline-block text-[13px] font-medium text-accent underline decoration-line underline-offset-[5px] hover:decoration-accent">Solve it in the {puzzles[0].lesson} lesson →</a>
              </>
            ) : (
              <p class="mt-3 text-[13px] leading-snug text-muted">Puzzles appear as lessons with a Diagnose or Ballpark exercise are published.</p>
            )
          }
        </div>
        <div id="streak" class="rounded-xl border border-line bg-surface p-5 sm:col-span-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <p class="text-[13px] font-medium text-muted">Streak</p>
            <p id="streak-meta" class="font-mono text-[12px] tabular-nums text-muted"></p>
          </div>
          <p class="mt-2 text-[2.25rem] font-semibold leading-none tracking-[-0.03em] tabular-nums"><span id="streak-count">0</span><span class="ml-2 text-[1rem] font-medium tracking-normal text-muted">days in a row</span></p>
          <div id="heatmap" class="mt-4 min-h-[7.5rem] max-w-[420px]"></div>
          <p id="streak-empty" class="mt-1 text-[13px] leading-snug text-muted">Finish a lesson or answer a review question to light up today. Activity stays in this browser.</p>
          <p class="mt-3 flex items-center gap-1.5 font-mono text-[12px] text-muted" aria-hidden="true">
            Less
            {[0, 1, 2, 3, 4].map((l) => <span class="inline-block h-3 w-3 rounded-[3px]" style={`background: var(--heat-${l})`}></span>)}
            More
          </p>
        </div>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="shape-h">
      <h2 id="shape-h" class="flex items-center gap-3 font-mono text-[12px] font-normal text-muted">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        how a lesson works
      </h2>
      <ol class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4 lg:grid-cols-7">
        {
          shape.map((s, i) => (
            <li class="border-t border-line pt-3">
              <span class="font-display text-[1.9rem] italic leading-[0.8] text-accent" aria-hidden="true">{i + 1}</span>
              <span class="mt-2 block text-[14px] font-medium leading-snug">{s}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
  <script type="application/json" id="hub-data" set:html={JSON.stringify(hubData)} is:inline />
</Layout>

<script>
  import { loadCards, loadActivity, isoDay } from '../lib/mastery';
  import { onPage } from '../lib/page';

  const read = <T,>(key: string, fallback: T): T => {
    try {
      return JSON.parse(localStorage.getItem(key) ?? 'null') ?? fallback;
    } catch {
      return fallback;
    }
  };

  // Same puzzle for everyone on the same local day: hash of the ISO date picks from the build-time bank.
  const pickPuzzle = (data: any) => {
    const list: any[] = data.puzzles ?? [];
    if (!list.length) return;
    let h = 2166136261;
    for (const c of isoDay()) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
    const p = list[(h >>> 0) % list.length];
    const set = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };
    set('puzzle-title', p.title);
    set('puzzle-scenario', p.scenario);
    set('puzzle-kind', p.kind === 'Ballpark' ? 'Ballpark' : 'Diagnose');
    const a = document.getElementById('puzzle-link') as HTMLAnchorElement | null;
    if (a) {
      a.textContent = `Solve it in the ${p.lesson} lesson →`;
      a.href = p.href;
    }
  };

  const NS = 'http://www.w3.org/2000/svg';
  const WEEKS = 18;
  const CELL = 12;
  const GAP = 3;
  const paintStreak = () => {
    const host = document.getElementById('heatmap');
    if (!host) return;
    const counts = new Map<string, number>();
    for (const d of loadActivity()) counts.set(d, (counts.get(d) ?? 0) + 1);

    // Streak: consecutive days ending today, or yesterday if today has no activity yet.
    const cursor = new Date();
    cursor.setHours(12, 0, 0, 0);
    if (!counts.has(isoDay(cursor))) cursor.setDate(cursor.getDate() - 1);
    let streak = 0;
    while (counts.has(isoDay(cursor))) {
      streak++;
      cursor.setDate(cursor.getDate() - 1);
    }

    const today = new Date();
    today.setHours(12, 0, 0, 0);
    const start = new Date(today);
    start.setDate(start.getDate() - today.getDay() - (WEEKS - 1) * 7); // Sunday of the first column
    const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 6 ? 3 : 4);
    const svg = document.createElementNS(NS, 'svg');
    const width = WEEKS * (CELL + GAP) - GAP;
    const height = 7 * (CELL + GAP) - GAP;
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    svg.setAttribute('class', 'block w-full');
    svg.setAttribute('role', 'img');
    let active = 0;
    for (let w = 0; w < WEEKS; w++) {
      for (let d = 0; d < 7; d++) {
        const day = new Date(start);
        day.setDate(start.getDate() + w * 7 + d);
        if (day > today) continue;
        const iso = isoDay(day);
        const n = counts.get(iso) ?? 0;
        if (n) active++;
        const rect = document.createElementNS(NS, 'rect');
        rect.setAttribute('x', String(w * (CELL + GAP)));
        rect.setAttribute('y', String(d * (CELL + GAP)));
        rect.setAttribute('width', String(CELL));
        rect.setAttribute('height', String(CELL));
        rect.setAttribute('rx', '3');
        rect.setAttribute('fill', `var(--heat-${level(n)})`);
        const title = document.createElementNS(NS, 'title');
        title.textContent = `${day.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' })}: ${n} ${n === 1 ? 'activity' : 'activities'}`;
        rect.appendChild(title);
        svg.appendChild(rect);
      }
    }
    svg.setAttribute('aria-label', `Activity over the last ${WEEKS} weeks: ${active} active ${active === 1 ? 'day' : 'days'}, current streak ${streak} ${streak === 1 ? 'day' : 'days'}`);
    host.replaceChildren(svg);
    document.getElementById('streak-count')!.textContent = String(streak);
    document.getElementById('streak-meta')!.textContent = active ? `${active} active ${active === 1 ? 'day' : 'days'} in the last ${WEEKS} weeks` : '';
    document.getElementById('streak-empty')?.classList.toggle('hidden', active > 0);
  };

  const paint = () => {
    const el = document.getElementById('hub-data');
    if (!el) return;
    const data = JSON.parse(el.textContent!);
    const done: string[] = read('sd-progress', []);
    const last = read<{ id: string; track: string } | null>('sd-last', null);

    // Module strips: a segment turns green when every ready lesson in it is done
    document.querySelectorAll<HTMLElement>('.strip > [data-ids]').forEach((s) => {
      const ids: string[] = JSON.parse(s.dataset.ids!);
      s.classList.toggle('is-done', ids.length > 0 && ids.every((id) => done.includes(id)));
    });

    // Resume strip and per-track Resume links
    const strip = document.getElementById('resume')!;
    const known = last && data.lessons[last.id] ? last : null;
    const t = known ? (data.lessons[known.id][2] as string) : 'backend';
    const ids: string[] = data.tracks[t].ready;
    const n = ids.filter((id) => done.includes(id)).length;
    if (known) {
      const [num, title] = data.lessons[known.id];
      document.getElementById('resume-label')!.textContent = 'Continue:';
      document.getElementById('resume-title')!.textContent = `${num} ${title} · ${data.tracks[t].name}`;
      strip.setAttribute('href', data.hrefs[known.id]);
    } else if (data.start) {
      document.getElementById('resume-label')!.textContent = 'Start here:';
      document.getElementById('resume-title')!.textContent = `${data.start.number} ${data.start.title}`;
      strip.setAttribute('href', data.start.href);
    }
    document.getElementById('resume-bar')!.style.width = `${ids.length ? (n / ids.length) * 100 : 0}%`;
    document.getElementById('resume-meta')!.textContent = `${n}/${ids.length} ${data.tracks[t].name}`;
    strip.classList.remove('invisible');

    document.querySelectorAll<HTMLAnchorElement>('[data-resume]').forEach((a) => {
      const track = a.dataset.resume!;
      const list: string[] = data.tracks[track].ready;
      const started = list.some((id) => done.includes(id)) || known?.track === track;
      const next = known && data.lessons[known.id][2] === track ? known.id : list.find((id) => !done.includes(id));
      if (started && next) a.setAttribute('href', data.hrefs[next]);
      a.classList.toggle('hidden', !(started && next));
    });

    document.getElementById('due-count')!.textContent = String(Object.values(loadCards()).filter((c) => c.due <= Date.now()).length);
    pickPuzzle(data);
    paintStreak();
  };
  addEventListener('sd-progress', paint);
  addEventListener('sd-mastery', paint);
  onPage(paint);
</script>
