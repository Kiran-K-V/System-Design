---
import Layout from '../layouts/Layout.astro';
import { loadSyllabus } from '../lib/lessons';
import CourseMap from '../components/lesson/CourseMap';

const { modules, flat } = await loadSyllabus();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstWritten = flat.find((l) => l.written);
const readyCount = flat.filter((l) => l.written).length;
---

<Layout title="Uptime" modules={modules}>
  <div class="mx-auto max-w-[860px]">
    <p class="flex items-center gap-3 font-mono text-[12px] tracking-[0.02em] text-muted">
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      Uptime · system design from first principles
    </p>
    <h1 class="mt-6 max-w-[15ch] text-[clamp(2.75rem,7.5vw,5rem)] font-semibold leading-[0.95] tracking-[-0.045em]">
      Become the engineer who <em class="font-display text-[1.12em] font-normal italic leading-[0.8] tracking-[-0.015em] text-accent">knows&nbsp;stuff.</em>
    </h1>
    <p class="mt-7 max-w-[52ch] text-[1.075rem] leading-[1.65] text-muted">
      Each lesson builds only on the lessons before it. Each hard idea has a diagram you can step through, so you learn why each box exists, not just where it goes.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
      {
        firstWritten && (
          <a
            href={`${base}/learn/${firstWritten.id}/`}
            class="press group inline-flex items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg hover:opacity-90"
          >
            Start with {firstWritten.number} {firstWritten.title}
            <svg class="transition-transform duration-200 group-hover:translate-x-0.5" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" /></svg>
          </a>
        )
      }
      <a href="#roadmap" class="press text-sm font-medium underline decoration-line decoration-1 underline-offset-[6px] hover:decoration-accent">
        Browse the roadmap
      </a>
      <span class="font-mono text-[12px] tabular-nums text-muted">{readyCount}/{flat.length} lessons ready</span>
    </div>

    <figure class="mt-14 hidden sm:block" aria-label="How the course stacks">
      <CourseMap />
    </figure>

    <section id="roadmap" class="mt-16 scroll-mt-20">
      <h2 class="flex items-center gap-3 font-mono text-[12px] font-normal text-muted">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        roadmap
      </h2>
      <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11.5px] text-muted" aria-hidden="true">
        <span class="flex items-center gap-2"><span class="rm-key rm-key-done"></span>done</span>
        <span class="flex items-center gap-2"><span class="rm-key"></span>ready</span>
        <span class="flex items-center gap-2"><span class="rm-key rm-key-soon"></span>coming soon</span>
      </p>

      <ol class="roadmap mt-10">
        {
          modules.map((m) => {
            const ready = m.lessons.filter((l) => l.written).length;
            const half = Math.ceil(m.lessons.length / 2);
            const sides = [m.lessons.slice(0, half), m.lessons.slice(half)];
            return (
              <li id={`module-${m.number}`} class="rm-module scroll-mt-20" data-module-ready={ready}>
                <div class:list={['rm-node', ready === 0 && 'rm-node-soon']}>
                  <span class="font-display text-[1.9rem] italic leading-[0.8] text-muted" aria-hidden="true">{m.number}</span>
                  <span class="min-w-0">
                    <h3 class="text-[1rem] font-semibold leading-tight tracking-[-0.015em]">
                      <span class="sr-only">Module {m.number}: </span>{m.title}
                    </h3>
                    <span class="mt-1 block font-mono text-[11px] tabular-nums text-muted">
                      {ready === 0 ? 'soon' : `${ready}/${m.lessons.length} ready`}
                    </span>
                  </span>
                </div>
                {sides.map((side, k) =>
                  side.length > 0 && (
                    <ul class:list={['rm-side', k === 0 ? 'rm-left' : 'rm-right']}>
                      {side.map((l) => (
                        <li class="rm-leaf">
                          {l.written ? (
                            <a href={`${base}/learn/${l.id}/`} class="rm-lesson" data-rm={l.id}>
                              <span class="rm-num">{l.number}</span>
                              <span class="rm-title">{l.title}</span>
                              <svg class="rm-check" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="done"><path d="M2.5 6.2 5 8.6l4.5-5" /></svg>
                            </a>
                          ) : (
                            <span class="rm-lesson rm-lesson-soon">
                              <span class="rm-num">{l.number}</span>
                              <span class="rm-title">{l.title}</span>
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )
                )}
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</Layout>

<script>
  // Mark finished lessons on the roadmap. Progress lives in this browser only.
  const paint = () => {
    let done: string[] = [];
    try {
      done = JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
    } catch {}
    document.querySelectorAll<HTMLElement>('[data-rm]').forEach((el) => el.classList.toggle('is-done', done.includes(el.dataset.rm!)));
  };
  paint();
  addEventListener('sd-progress', paint);
</script>
