---
import Layout from '../layouts/Layout.astro';
import { loadSyllabus } from '../lib/lessons';
import CourseMap from '../components/lesson/CourseMap';
import Beam from '../components/Beam';

const { modules, flat } = await loadSyllabus();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstWritten = flat.find((l) => l.written);
const readyCount = flat.filter((l) => l.written).length;
---

<Layout title="Groundwork" modules={modules}>
  <div class="mx-auto max-w-[860px]">
    <p class="chip chip-accent text-[12px]"><span class="dot"></span>Interactive course</p>
    <h1 class="mt-4 text-[2.25rem] font-bold leading-[1.08] tracking-[-0.035em] sm:text-[3rem]">
      System design,<br class="hidden sm:block" /> <span class="text-gradient">from first principles</span>
    </h1>
    <p class="mt-4 max-w-[600px] text-[1.1rem] leading-relaxed text-muted">
      Each lesson builds only on lessons before it. Each hard idea has a diagram you can step through.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      {
        firstWritten && (
          <Beam client:visible colors="colorful" radius={8}>
          <a
            href={`${base}/learn/${firstWritten.id}/`}
            class="inline-flex items-center gap-2 rounded-lg bg-fg px-4 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90"
          >
            Start with {firstWritten.number} {firstWritten.title}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" /></svg>
          </a>
          </Beam>
        )
      }
      <a href="#roadmap" class="inline-flex items-center rounded-lg border border-line px-4 py-2.5 text-sm font-medium transition-colors hover:border-accent/50 hover:bg-surface">
        Browse roadmap
      </a>
      <span class="text-sm text-muted">{readyCount} of {flat.length} lessons ready</span>
    </div>

    <figure class="mt-10 rounded-2xl border border-line bg-surface/50 p-4 sm:p-6">
      <CourseMap />
      <figcaption class="mt-1 text-center text-[13px] text-muted">How the course stacks. Click a layer to jump to it.</figcaption>
    </figure>

    <div id="roadmap" class="mt-12 grid scroll-mt-20 gap-4 md:grid-cols-2">
      {
        modules.map((m) => {
          const ready = m.lessons.filter((l) => l.written).length;
          return (
            <section id={`module-${m.number}`} class="scroll-mt-20 rounded-xl border border-line p-4">
              <div class="flex items-start gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-surface text-xs font-semibold tabular-nums text-muted">
                  {m.number}
                </span>
                <div class="min-w-0 flex-1">
                  <h2 class="text-[15px] font-semibold leading-snug tracking-[-0.01em]">{m.title}</h2>
                  <p class="mt-0.5 text-xs text-muted">
                    {m.lessons.length} lessons{ready > 0 ? ` · ${ready} ready` : ''}
                  </p>
                </div>
                {ready === 0 && <span class="soon-pill mt-0.5">Soon</span>}
              </div>
              {ready > 0 && (
                <ul class="mt-3 space-y-0.5 border-t border-line pt-2.5 text-sm">
                  {m.lessons.map((l) => (
                    <li>
                      {l.written ? (
                        <a href={`${base}/learn/${l.id}/`} class="-mx-2 flex items-center gap-2.5 rounded-md px-2 py-1 hover:bg-surface hover:text-accent">
                          <span class="w-7 text-xs tabular-nums text-muted">{l.number}</span>
                          {l.title}
                        </a>
                      ) : (
                        <span class="-mx-2 flex items-center gap-2.5 px-2 py-1 text-muted/80">
                          <span class="w-7 text-xs tabular-nums">{l.number}</span>
                          <span class="flex-1">{l.title}</span>
                          <span class="soon-pill">Soon</span>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>
