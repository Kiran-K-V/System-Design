---
import Layout from '../layouts/Layout.astro';
import { loadSyllabus } from '../lib/lessons';
import { FlowDemo, SequenceDemo } from '../components/anim/KitDemo';
import CourseMap from '../components/lesson/CourseMap';

const { modules } = await loadSyllabus();
---

<Layout title="Animation kit" modules={modules}>
  <div class="mx-auto max-w-[720px]">
    <h1 class="text-3xl font-bold tracking-tight">Animation kit</h1>
    <p class="mt-2 text-muted">Reference uses of each diagram component. Not part of the course.</p>
    <FlowDemo client:visible />
    <SequenceDemo client:visible />
    <h2 class="mt-10 text-lg font-semibold">Static sketch (no JavaScript)</h2>
    <CourseMap />
  </div>
</Layout>
