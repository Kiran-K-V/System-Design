---
import LessonPage from '../../../components/LessonPage.astro';
import { loadSyllabus } from '../../../lib/lessons';
import { trackOf } from '../../../lib/tracks';

// The URL drops the `ai/` prefix: id "ai/a5-inference/kv-cache" is served at /learn/ai/a5-inference/kv-cache/.
export async function getStaticPaths() {
  const { entries } = await loadSyllabus();
  return entries.filter((e) => trackOf(e.id) === 'ai').map((entry) => ({ params: { id: entry.id.slice(3) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<LessonPage entry={entry} track="ai" />
