---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { loadSyllabus } from '../../lib/lessons';
import Table from '../../components/lesson/Table.astro';

export async function getStaticPaths() {
  const { entries } = await loadSyllabus();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { modules, flat } = await loadSyllabus();
const { Content, headings } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const self = flat.find((l) => l.id === entry.id)!;
const written = flat.filter((l) => l.written);
const pos = written.findIndex((l) => l.id === entry.id);
const prev = written[pos - 1];
const next = written[pos + 1];
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 220));
const requires = entry.data.requires.map((r) => flat.find((l) => l.id === r)!);
---

<Layout title={self.title} modules={modules} currentId={entry.id} headings={headings}>
  <article class="mx-auto max-w-[700px]">
    <nav class="flex items-center gap-1.5 text-[13px] text-muted" aria-label="Breadcrumb">
      <a href={`${base}/`} class="hover:text-fg">Course</a>
      <span aria-hidden="true">/</span>
      <span>{self.moduleTitle}</span>
    </nav>
    <h1 class="mt-3 text-[2.15rem] font-bold leading-[1.15] tracking-[-0.03em] sm:text-[2.5rem]">{self.title}</h1>
    <p class="mt-4 text-[1.1rem] leading-relaxed text-muted">{entry.data.summary}</p>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-muted">
      <span class="font-medium tabular-nums">Lesson {self.number}</span>
      <span class="flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="7" cy="7" r="5.5" /><path d="M7 4v3.2l2 1.2" /></svg>
        {minutes} min read
      </span>
      {
        requires.length > 0 && (
          <span class="flex flex-wrap items-center gap-1.5">
            Builds on
            {requires.map((r) => (
              <a href={`${base}/learn/${r.id}/`} class="rounded-md bg-surface px-1.5 py-0.5 font-medium text-fg/80 hover:text-accent">
                {r.number}
              </a>
            ))}
          </span>
        )
      }
    </div>

    <div class="prose mt-10 dark:prose-invert">
      <Content components={{ table: Table }} />
    </div>

    <div class="mt-12 flex justify-center">
      <button
        id="complete-btn"
        data-id={entry.id}
        class="rounded-lg border border-line px-4 py-2 text-sm font-medium transition-colors hover:bg-surface"
      >
        Mark complete
      </button>
    </div>

    <nav class="mt-8 grid grid-cols-2 gap-4 border-t border-line pt-6 text-sm">
      <div>
        {
          prev && (
            <a href={`${base}/learn/${prev.id}/`} class="block rounded-xl border border-line p-4 transition-colors hover:border-accent/50 hover:bg-surface">
              <span class="text-muted">← Previous</span>
              <span class="mt-1 block font-medium">{prev.title}</span>
            </a>
          )
        }
      </div>
      <div class="text-right">
        {
          next && (
            <a href={`${base}/learn/${next.id}/`} class="block rounded-xl border border-line p-4 transition-colors hover:border-accent/50 hover:bg-surface">
              <span class="text-muted">Next →</span>
              <span class="mt-1 block font-medium">{next.title}</span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Layout>

<script>
  const btn = document.getElementById('complete-btn')!;
  const id = btn.dataset.id!;
  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
    } catch {
      return [];
    }
  };
  const paint = () => {
    const done = read().includes(id);
    btn.textContent = done ? '✓ Completed' : 'Mark complete';
    btn.classList.toggle('text-ok', done);
    document.querySelector(`[data-lesson="${id}"] .done-mark`)?.classList.toggle('hidden', !done);
  };
  btn.addEventListener('click', () => {
    const set = new Set(read());
    set.has(id) ? set.delete(id) : set.add(id);
    try {
      localStorage.setItem('sd-progress', JSON.stringify([...set]));
    } catch {}
    paint();
  });
  paint();
</script>
