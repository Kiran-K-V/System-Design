---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { loadSyllabus } from '../../lib/lessons';
import Table from '../../components/lesson/Table.astro';

export async function getStaticPaths() {
  const { entries } = await loadSyllabus();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { modules, flat } = await loadSyllabus();
const { Content, headings } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const self = flat.find((l) => l.id === entry.id)!;
const written = flat.filter((l) => l.written);
const pos = written.findIndex((l) => l.id === entry.id);
const prev = written[pos - 1];
const next = written[pos + 1];
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 220));
const interactive = /client:(visible|load|idle)/.test(entry.body ?? '');
const moduleNumber = parseInt(entry.id.split('/')[0], 10);
const level = moduleNumber <= 1 ? 'Beginner' : moduleNumber <= 5 ? 'Intermediate' : 'Advanced';
const order = (id: string) => flat.findIndex((l) => l.id === id);
const requires = entry.data.requires.map((r) => flat.find((l) => l.id === r)!).sort((x, y) => order(x.id) - order(y.id));
---

<Layout title={self.title} description={entry.data.summary} modules={modules} currentId={entry.id} headings={headings}>
  <article class="mx-auto max-w-[700px]">
    <header class="border-b border-line pb-8">
      <div class="flex items-baseline justify-between gap-4 font-mono text-[12px] text-muted">
        <nav class="flex min-w-0 items-baseline gap-2" aria-label="Breadcrumb">
          <a href={`${base}/`} class="hover:text-fg">Course</a>
          <span aria-hidden="true">/</span>
          <span class="truncate">{self.moduleTitle}</span>
        </nav>
        <span class="hidden shrink-0 items-baseline gap-4 sm:flex">
          {prev && <a href={`${base}/learn/${prev.id}/`} class="hover:text-fg" aria-label={`Previous: ${prev.title}`}>← {prev.number}</a>}
          {next && <a href={`${base}/learn/${next.id}/`} class="hover:text-fg" aria-label={`Next: ${next.title}`}>{next.number} →</a>}
        </span>
      </div>

      <p class="mt-10 font-display text-[clamp(4rem,9vw,6rem)] italic leading-[0.75] tracking-[-0.02em] text-accent" aria-hidden="true">{self.number}</p>
      <h1 class="mt-4 text-[clamp(2.4rem,5.5vw,3.4rem)] font-semibold leading-[1.02] tracking-[-0.04em]">
        <span class="sr-only">Lesson {self.number}: </span>{self.title}
      </h1>
      <p class="mt-5 max-w-[58ch] text-[1.125rem] leading-[1.6] text-muted">{entry.data.summary}</p>

      {
        requires.length > 0 && (
          <nav class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px]" aria-label="Builds on">
            <span class="font-mono text-[12px] text-muted">builds on</span>
            {requires.map((r) => (
              <a href={`${base}/learn/${r.id}/`} class="group inline-flex items-baseline gap-1.5 text-muted hover:text-fg">
                <span class="font-mono text-[12px] tabular-nums">{r.number}</span>
                <span class="underline decoration-line underline-offset-4 group-hover:decoration-accent">{r.title}</span>
              </a>
            ))}
            <span class="flex items-center text-line" aria-hidden="true">
              <span class="h-px w-8 bg-current"></span>
              <svg width="7" height="10" viewBox="0 0 7 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l4.5 4L1 9" /></svg>
            </span>
            <span class="inline-flex items-baseline gap-1.5 font-medium text-fg" aria-current="page">
              <span class="relative top-[-1px] h-2 w-2 self-center rounded-full bg-accent"></span>
              <span class="font-mono text-[12px] tabular-nums">{self.number}</span>
              {self.title}
            </span>
          </nav>
        )
      }

      <p class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-[12px] text-muted">
        <span>{minutes} min read</span>
        {interactive && (<><span aria-hidden="true">·</span><span>interactive</span></>)}
        <span aria-hidden="true">·</span>
        <span>{level.toLowerCase()}</span>
      </p>
    </header>

    <div class="prose mt-10 dark:prose-invert">
      <Content components={{ table: Table }} />
    </div>

    <div class="mt-14 flex justify-center">
      <button
        id="complete-btn"
        data-id={entry.id}
        class="press rounded-md border border-line px-4 py-2 text-sm font-medium hover:border-fg/30"
      >
        Mark complete
      </button>
    </div>

    <nav class="mt-10 grid grid-cols-2 gap-6 border-t border-line pt-6" aria-label="Lesson navigation">
      <div>
        {
          prev && (
            <a href={`${base}/learn/${prev.id}/`} class="group block">
              <span class="font-mono text-[12px] text-muted">← Previous · {prev.number}</span>
              <span class="mt-1.5 block text-[1.05rem] font-medium leading-snug tracking-[-0.01em] group-hover:text-accent">{prev.title}</span>
            </a>
          )
        }
      </div>
      <div class="text-right">
        {
          next && (
            <a href={`${base}/learn/${next.id}/`} class="group block">
              <span class="font-mono text-[12px] text-muted">Next · {next.number} →</span>
              <span class="mt-1.5 block text-[1.05rem] font-medium leading-snug tracking-[-0.01em] group-hover:text-accent">{next.title}</span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Layout>

<script>
  const btn = document.getElementById('complete-btn')!;
  const id = btn.dataset.id!;
  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
    } catch {
      return [];
    }
  };
  const paint = () => {
    const done = read().includes(id);
    btn.textContent = done ? '✓ Completed' : 'Mark complete';
    btn.classList.toggle('text-ok', done);
    document.querySelector(`[data-lesson="${id}"] .done-mark`)?.classList.toggle('hidden', !done);
  };
  btn.addEventListener('click', () => {
    const set = new Set(read());
    set.has(id) ? set.delete(id) : set.add(id);
    try {
      localStorage.setItem('sd-progress', JSON.stringify([...set]));
    } catch {}
    paint();
    dispatchEvent(new Event('sd-progress'));
  });
  paint();
</script>
