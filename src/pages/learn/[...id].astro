---
// Legacy URL: /learn/<id>/ moved to /learn/backend/<id>/. Backend MDX bodies still link the old form.
import { loadSyllabus } from '../../lib/lessons';
import { lessonHref, trackOf } from '../../lib/tracks';

export async function getStaticPaths() {
  const { entries } = await loadSyllabus();
  return entries.filter((e) => trackOf(e.id) === 'backend').map((e) => ({ params: { id: e.id }, props: { to: lessonHref(e.id) } }));
}

const { to } = Astro.props;
const canonical = new URL(to, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:," />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This lesson moved to <a href={to}>{to}</a>.</p>
  </body>
</html>
