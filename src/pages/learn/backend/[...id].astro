---
import LessonPage from '../../../components/LessonPage.astro';
import { loadSyllabus } from '../../../lib/lessons';
import { trackOf } from '../../../lib/tracks';

export async function getStaticPaths() {
  const { entries } = await loadSyllabus();
  return entries.filter((e) => trackOf(e.id) === 'backend').map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<LessonPage entry={entry} track="backend" />
