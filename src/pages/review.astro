---
import Layout from '../layouts/Layout.astro';
import { loadSyllabus } from '../lib/lessons';
import Review from '../components/lesson/Review';

const { modules } = await loadSyllabus();
---

<Layout title="Review" description="Spaced review of questions from lessons you finished." modules={modules}>
  <div class="mx-auto max-w-[700px]">
    <h1 class="text-3xl font-bold tracking-tight">Review</h1>
    <p class="mt-2 text-muted">
      Questions come back after 1, 2, 4, 8, then 16 days. A wrong answer sends a question back to day 1. Progress stays in this browser.
    </p>
    <div class="mt-8"><Review client:load /></div>
  </div>
</Layout>
