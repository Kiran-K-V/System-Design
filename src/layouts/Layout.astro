---
import '../styles/global.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/architects-daughter/400.css';
import type { SyllabusModule } from '../lib/syllabus';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  modules: SyllabusModule[];
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const SITE = 'Uptime';
const {
  title,
  description = 'Learn System Design from first principles. Each lesson builds only on lessons before it, with diagrams you can step through.',
  modules,
  currentId,
  headings = [],
} = Astro.props;
const fullTitle = title === SITE ? `${SITE} · Become the engineer who knows stuff` : `${title} · ${SITE}`;
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.png`, Astro.site ?? Astro.url).href;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentModule = currentId?.split('/')[0];
const writtenIds = modules.flatMap((m) => m.lessons).filter((l) => l.written).map((l) => l.id);
const hasToc = toc.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={SITE} />
    <meta name="author" content="Kiran K V" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Uptime: become the engineer who knows stuff" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <script is:inline>
      try {
        const t = localStorage.getItem('sd-theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="font-sans text-fg">
    <header class="sticky top-0 z-30 h-16 border-b border-line bg-bg/85 backdrop-blur-md">
      <div class="flex h-full items-center gap-3 px-4 lg:px-5">
        <button
          id="menu-btn"
          class="-ml-1.5 rounded-md p-2 text-muted hover:bg-surface hover:text-fg lg:hidden"
          aria-label="Open menu"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
          </svg>
        </button>
        <a href={`${base}/`} class="group flex w-[16.25rem] shrink-0 items-center gap-3" aria-label="Uptime home">
          <span class="transition-transform duration-300 group-hover:-translate-y-px"><Logo size={40} /></span>
          <span class="hidden leading-none sm:block">
            <span class="block text-[21px] font-semibold tracking-[-0.04em]"><span class="text-accent">Up</span>time</span>
            <span class="mt-1.5 block text-[12.5px] font-medium tracking-[-0.01em] text-muted">Know the stuff behind the boxes.</span>
          </span>
        </a>

        <button
          id="search-btn"
          class="mx-auto hidden h-9 w-full max-w-[28rem] items-center gap-2.5 rounded-lg border border-line bg-surface px-3 text-left text-sm text-muted transition-colors hover:border-accent/50 md:flex"
          aria-label="Search lessons"
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.6" /><path d="M10.5 10.5L14 14" /></svg>
          <span class="flex-1">Search lessons, concepts, or topics…</span>
          <kbd class="rounded border border-line bg-bg px-1.5 py-0.5 font-sans text-[11px]">Ctrl K</kbd>
        </button>
        <div class="flex-1 md:hidden"></div>
        <button id="search-btn-sm" class="rounded-md p-2 text-muted hover:bg-surface hover:text-fg md:hidden" aria-label="Search lessons">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.6" /><path d="M10.5 10.5L14 14" /></svg>
        </button>

        <a
          href={`${base}/review/`}
          class="hidden rounded-md px-2 py-1.5 text-[13px] font-medium text-muted hover:bg-surface hover:text-fg sm:block"
          >Review<span id="review-due" class="ml-1.5 hidden rounded-full bg-accent px-1.5 text-xs text-white tabular-nums"></span></a
        >

        <button
          id="theme-btn"
          class="rounded-md p-2 text-muted hover:bg-surface hover:text-fg"
          aria-label="Toggle dark mode"
        >
          <svg class="theme-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="10" cy="10" r="3.6"></circle>
            <path d="M10 2v1.8M10 16.2V18M2 10h1.8M16.2 10H18M4.3 4.3l1.3 1.3M14.4 14.4l1.3 1.3M4.3 15.7l1.3-1.3M14.4 5.6l1.3-1.3"></path>
          </svg>
          <svg class="theme-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
            <path d="M16.5 11.6A7 7 0 1 1 8.4 3.5a5.6 5.6 0 0 0 8.1 8.1z"></path>
          </svg>
        </button>

        <a
          id="progress-pill"
          href={`${base}/#roadmap`}
          data-written={JSON.stringify(writtenIds)}
          class="hidden items-center gap-2.5 rounded-xl border border-line bg-surface py-1 pl-1.5 pr-3 sm:flex"
          aria-label="Course progress"
        >
          <svg width="30" height="30" viewBox="0 0 30 30" class="-rotate-90">
            <circle cx="15" cy="15" r="11" fill="none" stroke="var(--border)" stroke-width="3.5"></circle>
            <circle id="ring" cx="15" cy="15" r="11" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="69.115" stroke-dashoffset="69.115" style="transition: stroke-dashoffset .5s ease"></circle>
          </svg>
          <span class="leading-tight">
            <span id="progress-text" class="block text-[13px] font-medium tabular-nums">0 / {writtenIds.length} lessons</span>
            <span class="mt-1 block h-1 w-28 overflow-hidden rounded-full bg-line"><span id="progress-bar" class="block h-full w-0 rounded-full bg-accent transition-[width] duration-500"></span></span>
          </span>
        </a>
      </div>
      {currentId && <div id="read-progress" class="absolute bottom-[-1px] left-0 h-[2px] w-full origin-left scale-x-0 bg-accent"></div>}
    </header>

    <div id="backdrop" class="fixed inset-0 top-16 z-10 hidden bg-black/40 lg:hidden" aria-hidden="true"></div>

    <div class:list={['lg:grid lg:grid-cols-[17.5rem_minmax(0,1fr)]', hasToc && 'xl:grid-cols-[17.5rem_minmax(0,1fr)_15rem]']}>
      <aside
        id="sidebar"
        class="scroll-thin fixed bottom-0 left-0 top-16 z-20 hidden w-[17.5rem] overflow-y-auto border-r border-line bg-bg px-3 pb-10 pt-5 lg:sticky lg:top-16 lg:block lg:h-[calc(100vh-4rem)]"
      >
        <nav class="text-[13.5px]" aria-label="Course">
          <ul class="mb-5 space-y-0.5">
            <li>
              <a href={`${base}/`} class="flex items-center gap-3 rounded-md px-2 py-1.5 font-medium text-fg/85 hover:bg-surface hover:text-fg">
                <svg class="text-muted" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7.2 8 2.5l5.5 4.7V13a.5.5 0 0 1-.5.5h-3V9.5H6v4H3a.5.5 0 0 1-.5-.5z" /></svg>
                Home
              </a>
            </li>
            <li>
              <a href={`${base}/#roadmap`} class="flex items-center gap-3 rounded-md px-2 py-1.5 font-medium text-fg/85 hover:bg-surface hover:text-fg">
                <svg class="text-muted" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="4.5" height="4.5" rx="1" /><rect x="9" y="2.5" width="4.5" height="4.5" rx="1" /><rect x="2.5" y="9" width="4.5" height="4.5" rx="1" /><rect x="9" y="9" width="4.5" height="4.5" rx="1" /></svg>
                Roadmap
              </a>
            </li>
          </ul>
          <p class="mb-1.5 px-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted">Course</p>
          {
            modules.map((m) => {
              const ready = m.lessons.filter((l) => l.written).length;
              return (
                <details class="group mb-0.5" open={m.slug === currentModule || (!currentModule && ready > 0)}>
                  <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-md px-2 py-1.5 hover:bg-surface">
                    <span class="w-5 text-right text-xs tabular-nums text-muted">{m.number}</span>
                    <span class:list={['flex-1 font-semibold leading-snug', ready === 0 && 'text-muted']}>{m.title}</span>
                    {ready === 0 && <span class="soon-pill">Soon</span>}
                    <svg class="shrink-0 text-muted transition-transform group-open:rotate-90" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 2.5L8 6l-3.5 3.5" />
                    </svg>
                  </summary>
                  <ul class="mb-2 ml-[1.35rem] mt-0.5 border-l border-line">
                    {m.lessons.map((l) =>
                      l.written ? (
                        <li>
                          <a
                            href={`${base}/learn/${l.id}/`}
                            data-lesson={l.id}
                            aria-current={l.id === currentId ? 'page' : undefined}
                            class:list={[
                              '-ml-px flex items-center gap-2 border-l-2 py-1.5 pl-3.5 pr-2 leading-snug transition-colors',
                              l.id === currentId
                                ? 'border-accent bg-accent-soft font-medium text-accent'
                                : 'border-transparent text-fg/80 hover:border-line hover:bg-surface hover:text-fg',
                            ]}
                          >
                            <span class="flex-1">{l.title}</span>
                            <span class="done-mark hidden text-ok" aria-label="Completed">
                              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.4l2.6 2.6L11 4.6" /></svg>
                            </span>
                          </a>
                        </li>
                      ) : (
                        <li class="-ml-px flex cursor-default items-center gap-2 border-l-2 border-transparent py-1.5 pl-3.5 pr-2 leading-snug text-muted/80" aria-disabled="true">
                          <span class="flex-1">{l.title}</span>
                          <span class="soon-pill">Soon</span>
                        </li>
                      ),
                    )}
                  </ul>
                </details>
              );
            })
          }
        </nav>
      </aside>

      <main class="min-w-0 px-5 pb-24 pt-10 sm:px-8 lg:px-12 lg:pt-12">
        <slot />
        <footer class="mx-auto mt-24 flex max-w-[860px] items-center justify-between gap-4 border-t border-line pt-5 text-[12px] text-muted/70">
          <span class="flex items-center gap-2 font-mono tracking-[0.02em]"><span class="text-accent" aria-hidden="true">↑</span> Uptime</span>
          <a
            href="https://www.linkedin.com/in/kiran07x"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 transition-colors duration-200 hover:text-fg"
            aria-label="Kiran K V on LinkedIn"
          >
            Kiran K V
            <svg class="opacity-70 transition-opacity group-hover:opacity-100 group-hover:text-accent" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
          </a>
        </footer>
      </main>

      {
        hasToc && (
          <aside class="scroll-thin sticky top-16 hidden h-[calc(100vh-4rem)] overflow-y-auto py-10 pr-5 xl:block">
            <div class="rounded-2xl border border-line bg-surface/50 p-4">
            <p class="mb-3 text-[13px] font-semibold text-fg">On this page</p>
            <ul class="space-y-0.5 border-l border-line text-[13px]">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc={h.slug}
                    class:list={['-ml-px block border-l-2 border-transparent py-1 leading-snug text-muted transition-colors hover:text-fg', h.depth === 3 ? 'pl-6' : 'pl-3.5']}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
            </div>
          </aside>
        )
      }
    </div>

    <dialog id="search-dialog" class="m-0 mx-auto mt-[12vh] w-[min(36rem,calc(100vw-2rem))] rounded-2xl border border-line bg-bg p-0 text-fg shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm" data-base={base}>
      <div class="flex items-center gap-3 border-b border-line px-4">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--muted)" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.6" /><path d="M10.5 10.5L14 14" /></svg>
        <input id="search-input" type="text" autocomplete="off" placeholder="Search lessons, concepts, or topics…" class="h-12 flex-1 bg-transparent text-[15px] outline-none placeholder:text-muted" />
        <kbd class="rounded border border-line px-1.5 py-0.5 text-[11px] text-muted">Esc</kbd>
      </div>
      <ul id="search-results" class="max-h-[50vh] overflow-y-auto p-2 text-sm" role="listbox"></ul>
    </dialog>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('sd-theme', root.dataset.theme);
        } catch {}
      });

      // Mobile drawer
      const sidebar = document.getElementById('sidebar')!;
      const backdrop = document.getElementById('backdrop')!;
      const menuBtn = document.getElementById('menu-btn')!;
      const setDrawer = (open: boolean) => {
        sidebar.classList.toggle('hidden', !open);
        backdrop.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
      };
      menuBtn.addEventListener('click', () => setDrawer(sidebar.classList.contains('hidden')));
      backdrop.addEventListener('click', () => setDrawer(false));
      addEventListener('keydown', (e) => e.key === 'Escape' && setDrawer(false));

      // Completed marks and header progress
      let done: string[] = [];
      try {
        done = JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
      } catch {}
      for (const id of done) {
        document.querySelector(`[data-lesson="${id}"] .done-mark`)?.classList.remove('hidden');
      }
      const pill = document.getElementById('progress-pill');
      const paintProgress = () => {
        if (!pill) return;
        let now: string[] = [];
        try {
          now = JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
        } catch {}
        const written: string[] = JSON.parse(pill.dataset.written ?? '[]');
        const n = now.filter((d) => written.includes(d)).length;
        const frac = written.length ? n / written.length : 0;
        document.getElementById('progress-text')!.textContent = `${n} / ${written.length} lessons`;
        document.getElementById('progress-bar')!.style.width = `${frac * 100}%`;
        document.getElementById('ring')!.setAttribute('stroke-dashoffset', String(69.115 * (1 - frac)));
      };
      paintProgress();
      addEventListener('sd-progress', paintProgress);

      // Review badge: count of cards due now (questions answered before, whose date has come)
      const paintDue = () => {
        const badge = document.getElementById('review-due');
        if (!badge) return;
        let n = 0;
        try {
          const cards = JSON.parse(localStorage.getItem('sd-cards') ?? '{}');
          n = Object.values<{ due: number }>(cards).filter((c) => c.due <= Date.now()).length;
        } catch {}
        badge.textContent = String(n);
        badge.classList.toggle('hidden', n === 0);
      };
      paintDue();
      addEventListener('sd-mastery', paintDue);

      // Search palette (Ctrl/Cmd+K or "/")
      type Row = { id: string; title: string; number: string; module: string; summary: string };
      const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
      const input = document.getElementById('search-input') as HTMLInputElement;
      const list = document.getElementById('search-results')!;
      const siteBase = dialog.dataset.base ?? '';
      let rows: Row[] | null = null;
      let active = 0;
      const render = () => {
        const q = input.value.trim().toLowerCase();
        const hits = (rows ?? [])
          .map((r) => {
            const t = r.title.toLowerCase();
            const score = !q ? 1 : t.startsWith(q) ? 4 : t.includes(q) ? 3 : r.module.toLowerCase().includes(q) ? 2 : r.summary.toLowerCase().includes(q) ? 1 : 0;
            return { r, score };
          })
          .filter((x) => x.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 8);
        active = Math.min(active, Math.max(0, hits.length - 1));
        list.innerHTML = hits.length
          ? hits
              .map(
                (h, i) =>
                  `<li role="option" aria-selected="${i === active}"><a href="${siteBase}/learn/${h.r.id}/" class="flex items-baseline gap-3 rounded-lg px-3 py-2 ${i === active ? 'bg-accent-soft text-accent' : 'hover:bg-surface'}"><span class="w-8 shrink-0 text-xs tabular-nums text-muted">${h.r.number}</span><span class="min-w-0 flex-1"><span class="block font-medium">${h.r.title}</span><span class="block truncate text-xs text-muted">${h.r.module}</span></span></a></li>`,
              )
              .join('')
          : `<li class="px-3 py-6 text-center text-muted">${rows ? 'No lessons match.' : 'Loading…'}</li>`;
      };
      const openSearch = async () => {
        dialog.showModal();
        input.value = '';
        active = 0;
        render();
        input.focus();
        if (!rows) {
          try {
            rows = await (await fetch(`${siteBase}/search.json`)).json();
          } catch {
            rows = [];
          }
          render();
        }
      };
      document.getElementById('search-btn')?.addEventListener('click', openSearch);
      document.getElementById('search-btn-sm')?.addEventListener('click', openSearch);
      addEventListener('keydown', (e) => {
        const typing = (e.target as HTMLElement)?.matches?.('input, textarea, select, [contenteditable]');
        if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) {
          e.preventDefault();
          openSearch();
        }
      });
      input.addEventListener('input', () => {
        active = 0;
        render();
      });
      input.addEventListener('keydown', (e) => {
        const links = list.querySelectorAll('a');
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          active = (active + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % Math.max(1, links.length);
          render();
        } else if (e.key === 'Enter' && links[active]) {
          location.href = (links[active] as HTMLAnchorElement).href;
        }
      });
      dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

      // Scroll progress bar and active TOC entry
      const bar = document.getElementById('read-progress');
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
      const targets = links
        .map((a) => document.getElementById(a.dataset.toc!))
        .filter((el): el is HTMLElement => el !== null);
      const onScroll = () => {
        if (bar) {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        }
        if (!targets.length) return;
        let current = targets[0];
        for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t;
        for (const a of links) {
          const on = a.dataset.toc === current.id;
          a.classList.toggle('text-fg', on);
          a.classList.toggle('font-medium', on);
          a.classList.toggle('border-accent', on);
          a.classList.toggle('text-muted', !on);
          a.classList.toggle('border-transparent', !on);
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
