---
import '../styles/global.css';
import type { SyllabusModule } from '../lib/syllabus';

interface Props {
  title: string;
  modules: SyllabusModule[];
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, modules, currentId, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentModule = currentId?.split('/')[0];
const writtenIds = modules.flatMap((m) => m.lessons).filter((l) => l.written).map((l) => l.id);
const hasToc = toc.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · System Design</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('sd-theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="font-sans text-fg">
    <header class="sticky top-0 z-30 h-14 border-b border-line bg-bg/85 backdrop-blur-md">
      <div class="flex h-full items-center gap-3 px-4 lg:px-5">
        <button
          id="menu-btn"
          class="-ml-1.5 rounded-md p-2 text-muted hover:bg-surface hover:text-fg lg:hidden"
          aria-label="Open menu"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
          </svg>
        </button>
        <a href={`${base}/`} class="flex items-center gap-2.5 font-semibold tracking-tight">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-accent text-white">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M3 4.5h10M3 8h7M3 11.5h10"></path>
            </svg>
          </span>
          System Design
        </a>
        <div class="flex-1"></div>
        <span
          id="progress-pill"
          data-written={JSON.stringify(writtenIds)}
          class="hidden rounded-full border border-line px-2.5 py-1 text-xs font-medium tabular-nums text-muted sm:inline-block"
        ></span>
        <button
          id="theme-btn"
          class="rounded-md p-2 text-muted hover:bg-surface hover:text-fg"
          aria-label="Toggle dark mode"
        >
          <svg class="theme-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="10" cy="10" r="3.6"></circle>
            <path d="M10 2v1.8M10 16.2V18M2 10h1.8M16.2 10H18M4.3 4.3l1.3 1.3M14.4 14.4l1.3 1.3M4.3 15.7l1.3-1.3M14.4 5.6l1.3-1.3"></path>
          </svg>
          <svg class="theme-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
            <path d="M16.5 11.6A7 7 0 1 1 8.4 3.5a5.6 5.6 0 0 0 8.1 8.1z"></path>
          </svg>
        </button>
      </div>
      {currentId && <div id="read-progress" class="absolute bottom-[-1px] left-0 h-[2px] w-full origin-left scale-x-0 bg-accent"></div>}
    </header>

    <div id="backdrop" class="fixed inset-0 top-14 z-10 hidden bg-black/40 lg:hidden" aria-hidden="true"></div>

    <div class:list={['lg:grid lg:grid-cols-[17.5rem_minmax(0,1fr)]', hasToc && 'xl:grid-cols-[17.5rem_minmax(0,1fr)_15rem]']}>
      <aside
        id="sidebar"
        class="scroll-thin fixed bottom-0 left-0 top-14 z-20 hidden w-[17.5rem] overflow-y-auto border-r border-line bg-bg px-3 pb-10 pt-5 lg:sticky lg:top-14 lg:block lg:h-[calc(100vh-3.5rem)]"
      >
        <nav class="text-[13.5px]" aria-label="Course">
          {
            modules.map((m) => {
              const ready = m.lessons.filter((l) => l.written).length;
              return (
                <details class="group mb-0.5" open={m.slug === currentModule || (!currentModule && ready > 0)}>
                  <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-md px-2 py-1.5 hover:bg-surface">
                    <span class="w-5 text-right text-xs tabular-nums text-muted">{m.number}</span>
                    <span class:list={['flex-1 font-semibold leading-snug', ready === 0 && 'text-muted']}>{m.title}</span>
                    {ready === 0 && <span class="soon-pill">Soon</span>}
                    <svg class="shrink-0 text-muted transition-transform group-open:rotate-90" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 2.5L8 6l-3.5 3.5" />
                    </svg>
                  </summary>
                  <ul class="mb-2 ml-[1.35rem] mt-0.5 border-l border-line">
                    {m.lessons.map((l) =>
                      l.written ? (
                        <li>
                          <a
                            href={`${base}/learn/${l.id}/`}
                            data-lesson={l.id}
                            aria-current={l.id === currentId ? 'page' : undefined}
                            class:list={[
                              '-ml-px flex items-center gap-2 border-l-2 py-1.5 pl-3.5 pr-2 leading-snug transition-colors',
                              l.id === currentId
                                ? 'border-accent bg-accent-soft font-medium text-accent'
                                : 'border-transparent text-fg/80 hover:border-line hover:bg-surface hover:text-fg',
                            ]}
                          >
                            <span class="flex-1">{l.title}</span>
                            <span class="done-mark hidden text-ok" aria-label="Completed">
                              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.4l2.6 2.6L11 4.6" /></svg>
                            </span>
                          </a>
                        </li>
                      ) : (
                        <li class="-ml-px flex cursor-default items-center gap-2 border-l-2 border-transparent py-1.5 pl-3.5 pr-2 leading-snug text-muted/80" aria-disabled="true">
                          <span class="flex-1">{l.title}</span>
                          <span class="soon-pill">Soon</span>
                        </li>
                      ),
                    )}
                  </ul>
                </details>
              );
            })
          }
        </nav>
      </aside>

      <main class="min-w-0 px-5 pb-24 pt-10 sm:px-8 lg:px-12 lg:pt-12">
        <slot />
      </main>

      {
        hasToc && (
          <aside class="scroll-thin sticky top-14 hidden h-[calc(100vh-3.5rem)] overflow-y-auto py-12 pr-6 xl:block">
            <p class="mb-3 text-xs font-semibold text-fg">On this page</p>
            <ul class="space-y-0.5 border-l border-line text-[13px]">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc={h.slug}
                    class:list={['-ml-px block border-l-2 border-transparent py-1 leading-snug text-muted transition-colors hover:text-fg', h.depth === 3 ? 'pl-6' : 'pl-3.5']}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('sd-theme', root.dataset.theme);
        } catch {}
      });

      // Mobile drawer
      const sidebar = document.getElementById('sidebar')!;
      const backdrop = document.getElementById('backdrop')!;
      const menuBtn = document.getElementById('menu-btn')!;
      const setDrawer = (open: boolean) => {
        sidebar.classList.toggle('hidden', !open);
        backdrop.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
      };
      menuBtn.addEventListener('click', () => setDrawer(sidebar.classList.contains('hidden')));
      backdrop.addEventListener('click', () => setDrawer(false));
      addEventListener('keydown', (e) => e.key === 'Escape' && setDrawer(false));

      // Completed marks and header progress
      let done: string[] = [];
      try {
        done = JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
      } catch {}
      for (const id of done) {
        document.querySelector(`[data-lesson="${id}"] .done-mark`)?.classList.remove('hidden');
      }
      const pill = document.getElementById('progress-pill');
      if (pill) {
        const written: string[] = JSON.parse(pill.dataset.written ?? '[]');
        pill.textContent = `${done.filter((d) => written.includes(d)).length} / ${written.length} done`;
        pill.classList.remove('hidden');
      }

      // Scroll progress bar and active TOC entry
      const bar = document.getElementById('read-progress');
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
      const targets = links
        .map((a) => document.getElementById(a.dataset.toc!))
        .filter((el): el is HTMLElement => el !== null);
      const onScroll = () => {
        if (bar) {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        }
        if (!targets.length) return;
        let current = targets[0];
        for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t;
        for (const a of links) {
          const on = a.dataset.toc === current.id;
          a.classList.toggle('text-fg', on);
          a.classList.toggle('font-medium', on);
          a.classList.toggle('border-accent', on);
          a.classList.toggle('text-muted', !on);
          a.classList.toggle('border-transparent', !on);
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
