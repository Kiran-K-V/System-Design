---
import '../styles/global.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/architects-daughter/400.css';
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import { loadSyllabus } from '../lib/lessons';
import { tracks, trackHref, lessonHref, type TrackId } from '../lib/tracks';
import { videos, videosHref } from '../lib/videos';

interface Props {
  title: string;
  description?: string;
  /** The track this page belongs to. Leave out on the hub and on cross-track pages. */
  track?: TrackId;
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** 'cinema': the always-dark, red-to-violet theme of the Videos section. */
  zone?: 'cinema';
}

const SITE = 'Uptime';
const {
  title,
  description = 'Learn System Design from first principles. Each lesson builds only on lessons before it, with diagrams you can step through.',
  track,
  currentId,
  headings = [],
  zone,
} = Astro.props;
const fullTitle = title === SITE ? `${SITE} · Become the engineer who knows stuff` : `${title} · ${SITE}`;
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.png`, Astro.site ?? Astro.url).href;
let lastH2 = '';
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => {
    if (h.depth === 2) lastH2 = h.slug;
    return { ...h, parent: h.depth === 3 ? lastH2 : '' };
  });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const syl = await loadSyllabus();
const modules = track ? syl.tracks[track].modules : [];
const currentModule = syl.flat.find((l) => l.id === currentId)?.moduleSlug;
const counts = (t: TrackId) => {
  const flat = syl.tracks[t].flat;
  const ready = flat.filter((l) => l.written);
  return { ids: ready.map((l) => l.id), ready: ready.length, total: flat.length };
};
const stats = { backend: counts('backend'), ai: counts('ai') };
const pillData = {
  backend: { written: stats.backend.ids, denom: stats.backend.ready || stats.backend.total, short: tracks.backend.short },
  ai: { written: stats.ai.ids, denom: stats.ai.ready || stats.ai.total, short: tracks.ai.short },
};
const hasToc = toc.length > 0;
const ordered: TrackId[] = ['backend', 'ai'];
---

<!doctype html>
<html lang="en" data-track={track} data-zone={zone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={SITE} />
    <meta name="author" content="Kiran" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a0b" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Uptime: become the engineer who knows stuff" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <script is:inline>
      try {
        const t = localStorage.getItem('sd-theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
      // Client router swaps <html> attributes. Carry the live theme into the incoming document so it never flashes.
      document.addEventListener('astro:before-swap', (e) => {
        const t = document.documentElement.dataset.theme;
        if (t) e.newDocument.documentElement.dataset.theme = t;
      });
    </script>
    <ClientRouter />
  </head>
  <body class="font-sans text-fg">
    <header class="sticky top-0 z-30 h-16 border-b border-line bg-bg/85 backdrop-blur-md">
      <div class="flex h-full items-center gap-3 px-4 lg:px-5">
        <button
          id="menu-btn"
          class="-ml-1.5 rounded-md p-2 text-muted hover:bg-surface hover:text-fg lg:hidden"
          aria-label="Open menu"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
          </svg>
        </button>
        <a href={`${base}/`} class="group flex shrink-0 items-center gap-3 sm:w-[16.25rem]" aria-label="Uptime home">
          <span class="transition-transform duration-300 group-hover:-translate-y-px"><Logo size={40} /></span>
          <span class="hidden leading-none sm:block">
            <span class="block text-[21px] font-semibold tracking-[-0.04em]"><span class="text-accent">Up</span>time</span>
            <span class="mt-1.5 block text-[12.5px] font-medium tracking-[-0.01em] text-muted">Know the stuff behind the boxes.</span>
          </span>
        </a>

        <nav class="track-seg hidden md:inline-flex" aria-label="Track">
          {ordered.map((t) => (
            <a href={trackHref(t)} data-track-link={t} aria-current={track === t ? 'page' : undefined}>
              {tracks[t].short}
              {t === 'ai' && <span id="ai-new-dot" class="new-dot hidden" title="New track"></span>}
            </a>
          ))}
        </nav>

        <button
          id="search-btn"
          class="mx-auto hidden h-9 w-full min-w-0 max-w-[28rem] items-center gap-2.5 overflow-hidden rounded-lg border border-line bg-surface px-3 text-left text-sm text-muted transition-colors hover:border-accent/50 lg:flex"
          aria-label="Search lessons"
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.6" /><path d="M10.5 10.5L14 14" /></svg>
          <span class="min-w-0 flex-1 truncate">Search lessons, concepts, or topics…</span>
          <kbd class="rounded border border-line bg-bg px-1.5 py-0.5 font-sans text-xs">Ctrl K</kbd>
        </button>
        <div class="flex-1 lg:hidden"></div>
        <button id="search-btn-sm" class="rounded-md p-2 text-muted hover:bg-surface hover:text-fg lg:hidden" aria-label="Search lessons">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.6" /><path d="M10.5 10.5L14 14" /></svg>
        </button>

        <a href={`${base}/videos/`} class="vnav press" aria-label="Videos" aria-current={zone === 'cinema' ? 'page' : undefined}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
          <span class="hidden sm:inline">Videos</span>
        </a>
        <a
          href={`${base}/review/`}
          class="hidden rounded-md px-2 py-1.5 text-[13px] font-medium text-muted hover:bg-surface hover:text-fg sm:block"
          >Review<span id="review-due" class="ml-1.5 hidden rounded-full bg-accent px-1.5 text-xs text-on-accent tabular-nums"></span></a
        >
        <a href={`${base}/glossary/`} class="rounded-md p-2 text-muted hover:bg-surface hover:text-fg" aria-label="Glossary" title="Glossary">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3.5h9.5a1.5 1.5 0 0 1 1.5 1.5v11.5H5.5A1.5 1.5 0 0 1 4 15V3.5zM4 15a1.5 1.5 0 0 1 1.5-1.5H15" /><path d="M7.2 11l2.3-5.5 2.3 5.5M8 9.2h3" /></svg>
        </a>

        <button
          id="theme-btn"
          class="rounded-md p-2 text-muted hover:bg-surface hover:text-fg"
          aria-label="Toggle dark mode"
        >
          <svg class="theme-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="10" cy="10" r="3.6"></circle>
            <path d="M10 2v1.8M10 16.2V18M2 10h1.8M16.2 10H18M4.3 4.3l1.3 1.3M14.4 14.4l1.3 1.3M4.3 15.7l1.3-1.3M14.4 5.6l1.3-1.3"></path>
          </svg>
          <svg class="theme-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
            <path d="M16.5 11.6A7 7 0 1 1 8.4 3.5a5.6 5.6 0 0 0 8.1 8.1z"></path>
          </svg>
        </button>

        <a
          id="progress-pill"
          href={track ? trackHref(track) : `${base}/`}
          data-tracks={JSON.stringify(pillData)}
          data-current={track}
          class="hidden shrink-0 items-center gap-2.5 rounded-xl border border-line bg-surface py-1 pl-1.5 pr-3 lg:flex"
          aria-label={track ? `${tracks[track].name} progress` : 'Progress in both tracks'}
        >
          {
            track ? (
              <>
                <svg width="30" height="30" viewBox="0 0 30 30" class="-rotate-90">
                  <circle cx="15" cy="15" r="11" fill="none" stroke="var(--border)" stroke-width="3.5"></circle>
                  <circle id="ring" cx="15" cy="15" r="11" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="69.115" stroke-dashoffset="69.115" style="transition: stroke-dashoffset .5s ease"></circle>
                </svg>
                <span class="leading-tight">
                  <span data-pill-text={track} class="block text-[13px] font-medium tabular-nums">0 / {pillData[track].denom} {tracks[track].short}</span>
                  <span class="mt-1 block h-1 w-28 overflow-hidden rounded-full bg-line"><span data-pill-bar={track} class="block h-full w-0 rounded-full bg-accent transition-[width] duration-500"></span></span>
                </span>
              </>
            ) : (
              <span class="ml-1.5 grid gap-1 py-0.5">
                {ordered.map((t) => (
                  <span class="flex items-center gap-2 text-xs leading-none" style={`--tc: var(--c-${t})`}>
                    <span class="w-[3.75rem] text-muted">{tracks[t].short}</span>
                    <span class="block h-1 w-16 overflow-hidden rounded-full bg-line"><span data-pill-bar={t} class="block h-full w-0 rounded-full transition-[width] duration-500" style="background: var(--tc)"></span></span>
                    <span data-pill-text={t} class="w-10 text-right tabular-nums text-muted">0/{pillData[t].denom}</span>
                  </span>
                ))}
              </span>
            )
          }
        </a>
      </div>
      {currentId && <div id="read-progress" class="absolute bottom-[-1px] left-0 h-[2px] w-full origin-left scale-x-0 bg-accent"></div>}
    </header>

    <div id="backdrop" class="fixed inset-0 top-16 z-10 hidden bg-black/40 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>

    <div class:list={[track && 'lg:grid lg:grid-cols-[17.5rem_minmax(0,1fr)]', track && hasToc && 'xl:grid-cols-[17.5rem_minmax(0,1fr)_15rem]']}>
      <aside
        id="sidebar"
        transition:persist={`sidebar-${track ?? 'hub'}`}
        class:list={[
          'scroll-thin fixed bottom-0 left-0 top-16 z-20 hidden w-[17.5rem] overflow-y-auto border-r border-line bg-bg px-3 pb-10 pt-5',
          track ? 'lg:sticky lg:top-16 lg:block lg:h-[calc(100vh-4rem)]' : 'lg:hidden',
        ]}
      >
        <nav class="track-seg mb-4 flex w-full lg:hidden" aria-label="Track">
          {ordered.map((t) => (
            <a href={trackHref(t)} data-track-link={t} aria-current={track === t ? 'page' : undefined} class="flex-1 justify-center">
              {tracks[t].short}
            </a>
          ))}
        </nav>
        <nav class="text-[13.5px]" aria-label="Course">
          {
            track && (
              <div class="mb-4 rounded-xl border border-line bg-surface px-3 py-2.5">
                <p class="text-[13.5px] font-semibold leading-snug">{tracks[track].name}</p>
                <div class="mt-2 flex items-center gap-2.5">
                  <span class="block h-1 flex-1 overflow-hidden rounded-full bg-line"><span data-card-bar={track} class="block h-full w-0 rounded-full bg-accent transition-[width] duration-500"></span></span>
                  <span data-card-text={track} class="shrink-0 font-mono text-xs tabular-nums text-muted">0 / {pillData[track].denom} done</span>
                </div>
                {stats[track].ready < stats[track].total && <p class="mt-2 text-xs text-muted">{stats[track].total - stats[track].ready} more lessons on the way</p>}
              </div>
            )
          }
          <ul class="mb-5 space-y-0.5">
            <li>
              <a href={track ? trackHref(track) : `${base}/`} class="flex items-center gap-3 rounded-md px-2 py-1.5 font-medium text-fg/85 hover:bg-surface hover:text-fg">
                <svg class="text-muted" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7.2 8 2.5l5.5 4.7V13a.5.5 0 0 1-.5.5h-3V9.5H6v4H3a.5.5 0 0 1-.5-.5z" /></svg>
                {track ? 'Track home' : 'Home'}
              </a>
            </li>
            {
              track && (
                <li>
                  <a href={`${trackHref(track)}#roadmap`} class="flex items-center gap-3 rounded-md px-2 py-1.5 font-medium text-fg/85 hover:bg-surface hover:text-fg">
                    <svg class="text-muted" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="4.5" height="4.5" rx="1" /><rect x="9" y="2.5" width="4.5" height="4.5" rx="1" /><rect x="2.5" y="9" width="4.5" height="4.5" rx="1" /><rect x="9" y="9" width="4.5" height="4.5" rx="1" /></svg>
                    Roadmap
                  </a>
                </li>
              )
            }
            <li>
              <a href={videosHref(track)} class="flex items-center gap-3 rounded-md px-2 py-1.5 font-medium text-fg/85 hover:bg-surface hover:text-fg">
                <svg style="color: var(--c-backend)" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="3" width="13" height="10" rx="2" /><path d="M6.5 6v4l3.5-2z" fill="currentColor" /></svg>
                <span class="flex-1">Videos</span>
                <span class="font-mono text-[11.5px] tabular-nums text-muted">{track ? videos.filter((v) => v.track === track).length : videos.length}</span>
              </a>
            </li>
            <li class="sm:hidden">
              <a href={`${base}/review/`} class="flex items-center gap-3 rounded-md px-2 py-1.5 font-medium text-fg/85 hover:bg-surface hover:text-fg">
                <svg class="text-muted" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8a5 5 0 1 1-1.5-3.6M13 2.5v2.4h-2.4" /></svg>
                Review
              </a>
            </li>
          </ul>
          {track && <p class="mb-1.5 px-2 text-xs font-semibold uppercase tracking-[0.08em] text-muted">Course</p>}
          {
            modules.map((m, mi) => {
              const ready = m.lessons.filter((l) => l.written).length;
              const firstReady = modules.findIndex((x) => x.lessons.some((l) => l.written));
              return (
                <details class="group mb-0.5" data-module={m.slug} open={m.slug === currentModule || (!currentId && mi === Math.max(0, firstReady) && ready > 0)}>
                  <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-md px-2 py-1.5 hover:bg-surface">
                    <span class="w-7 text-right text-xs tabular-nums text-muted">{m.label}</span>
                    <span class:list={['flex-1 font-semibold leading-snug', ready === 0 && 'text-muted']}>{m.title}</span>
                    {ready === 0 && <span class="soon-pill">Soon</span>}
                    <svg class="shrink-0 text-muted transition-transform group-open:rotate-90" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 2.5L8 6l-3.5 3.5" />
                    </svg>
                  </summary>
                  <ul class="mb-2 ml-[1.35rem] mt-0.5 border-l border-line">
                    {m.lessons.map((l) =>
                      l.written ? (
                        <li>
                          <a
                            href={lessonHref(l.id)}
                            data-lesson={l.id}
                            aria-current={l.id === currentId ? 'page' : undefined}
                            class="-ml-px flex items-center gap-2 border-l-2 border-transparent py-1.5 pl-3.5 pr-2 leading-snug text-fg/80 transition-colors hover:border-line hover:bg-surface hover:text-fg aria-[current=page]:border-accent aria-[current=page]:bg-accent-soft aria-[current=page]:font-medium aria-[current=page]:text-accent aria-[current=page]:hover:border-accent aria-[current=page]:hover:bg-accent-soft aria-[current=page]:hover:text-accent"
                          >
                            <span class="flex-1">{l.title}</span>
                            <span class="done-mark hidden text-ok" aria-label="Completed">
                              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.4l2.6 2.6L11 4.6" /></svg>
                            </span>
                          </a>
                        </li>
                      ) : (
                        <li class="-ml-px flex cursor-default items-center gap-2 border-l-2 border-transparent py-1.5 pl-3.5 pr-2 leading-snug text-muted/80" aria-disabled="true">
                          <span class="flex-1">{l.title}</span>
                          <span class="soon-pill">Soon</span>
                        </li>
                      ),
                    )}
                  </ul>
                </details>
              );
            })
          }
        </nav>
      </aside>

      <main class="min-w-0 px-5 pb-24 pt-10 sm:px-8 lg:px-12 lg:pt-12">
        <slot />
        <footer class:list={["mx-auto mt-24 flex", track ? "max-w-[860px]" : "max-w-[1040px]"]} class=" items-center justify-between gap-4 border-t border-line pt-5 text-[12px] text-muted/70">
          <span class="flex items-center gap-2 font-mono tracking-[0.02em]"><span class="text-accent" aria-hidden="true">↑</span> Uptime</span>
          <a
            href="https://www.linkedin.com/in/kiran07x"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 transition-colors duration-200 hover:text-fg"
            aria-label="Kiran on LinkedIn"
          >
            Kiran
            <svg class="opacity-70 transition-opacity group-hover:opacity-100 group-hover:text-accent" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
          </a>
        </footer>
      </main>

      {
        hasToc && (
          <aside class="scroll-thin sticky top-16 hidden h-[calc(100vh-4rem)] overflow-y-auto py-10 pr-5 xl:block">
            <div class="rounded-2xl border border-line bg-surface/50 p-4">
            <p class="mb-3 text-[13px] font-semibold text-fg">On this page</p>
            <ul class="space-y-0 border-l border-line text-[13px]">
              {toc.map((h) => (
                <li data-toc-parent={h.parent || undefined} class:list={[h.depth === 3 && 'hidden']}>
                  <a
                    href={`#${h.slug}`}
                    data-toc={h.slug}
                    data-toc-depth={h.depth}
                    class:list={['-ml-px block border-l-2 border-transparent py-[3px] leading-snug text-muted transition-colors hover:text-fg', h.depth === 3 ? 'pl-6 text-[12.5px]' : 'pl-3.5']}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
            </div>
          </aside>
        )
      }
    </div>

    <dialog id="search-dialog" data-track={track ?? ''} class="m-0 mx-auto mt-[12vh] w-[min(36rem,calc(100vw-2rem))] rounded-2xl border border-line bg-bg p-0 text-fg shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm" data-base={base}>
      <div class="flex items-center gap-3 border-b border-line px-4">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--muted)" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.6" /><path d="M10.5 10.5L14 14" /></svg>
        <input id="search-input" type="text" autocomplete="off" placeholder="Search lessons, concepts, or topics…" class="h-12 flex-1 bg-transparent text-[15px] outline-none placeholder:text-muted" />
        <kbd class="rounded border border-line px-1.5 py-0.5 text-xs text-muted">Esc</kbd>
      </div>
      <div id="search-chips" class="flex gap-1.5 border-b border-line px-4 py-2" role="group" aria-label="Filter by track">
        {[['all', 'All'], ['backend', 'Backend'], ['ai', 'AI']].map(([k, label]) => (
          <button type="button" data-chip={k} class="chip rounded-full border border-line px-2.5 py-0.5 text-[13px] text-muted hover:text-fg">{label}</button>
        ))}
      </div>
      <ul id="search-results" class="max-h-[50vh] overflow-y-auto p-2 text-sm" role="listbox"></ul>
    </dialog>

    <script>
      import { onPage, once } from '../lib/page';

      const root = document.documentElement;
      const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
      const readJSON = <T,>(key: string, fallback: T): T => {
        try {
          return JSON.parse(localStorage.getItem(key) ?? 'null') ?? fallback;
        } catch {
          return fallback;
        }
      };

      // ---- Theme (button is replaced on each navigation, so bind per page)
      const bindTheme = () => {
        const btn = $('theme-btn');
        if (!once(btn)) return;
        btn.addEventListener('click', () => {
          const dark = root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
          root.dataset.theme = dark ? 'light' : 'dark';
          try {
            localStorage.setItem('sd-theme', root.dataset.theme);
          } catch {}
        });
      };

      // ---- Mobile drawer. The sidebar persists across pages, the menu button and scrim do not.
      const setDrawer = (open: boolean) => {
        $('sidebar')?.classList.toggle('hidden', !open);
        $('backdrop')?.classList.toggle('hidden', !open);
        $('menu-btn')?.setAttribute('aria-expanded', String(open));
      };
      const bindDrawer = () => {
        setDrawer(false);
        const menu = $('menu-btn');
        if (once(menu)) menu.addEventListener('click', () => setDrawer($('sidebar')!.classList.contains('hidden')));
        const scrim = $('backdrop');
        if (once(scrim)) scrim.addEventListener('click', () => setDrawer(false));
      };
      addEventListener('keydown', (e) => e.key === 'Escape' && setDrawer(false));

      // ---- Sidebar: persisted, so refresh active item, open module, done marks, and keep its scroll
      let sidebarScroll = 0;
      document.addEventListener('astro:before-swap', () => {
        sidebarScroll = $('sidebar')?.scrollTop ?? 0;
      });
      document.addEventListener('astro:after-swap', () => {
        const sb = $('sidebar');
        if (sb) sb.scrollTop = sidebarScroll;
      });
      const paintSidebar = () => {
        const sb = $('sidebar');
        if (!sb) return;
        const path = location.pathname.replace(/\/?$/, '/');
        let current: HTMLElement | null = null;
        sb.querySelectorAll<HTMLAnchorElement>('a[data-lesson]').forEach((a) => {
          const on = new URL(a.href).pathname.replace(/\/?$/, '/') === path;
          if (on) {
            a.setAttribute('aria-current', 'page');
            current = a;
          } else a.removeAttribute('aria-current');
        });
        (current as HTMLElement | null)?.closest('details')?.setAttribute('open', '');
        sb.querySelectorAll<HTMLAnchorElement>('a[data-track-link]').forEach((a) => {
          const on = a.dataset.trackLink === root.dataset.track;
          if (on) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
        sb.scrollTop = sidebarScroll;
        const cur = current as HTMLElement | null;
        if (cur) {
          const r = cur.getBoundingClientRect();
          const b = sb.getBoundingClientRect();
          if (r.top < b.top || r.bottom > b.bottom) sb.scrollTop += r.top - b.top - b.height / 3;
        }
      };

      // ---- Completed marks and header progress
      const paintProgress = () => {
        const now = readJSON<string[]>('sd-progress', []);
        for (const id of now) document.querySelector(`[data-lesson="${CSS.escape(id)}"] .done-mark`)?.classList.remove('hidden');
        const pill = $('progress-pill');
        if (!pill) return;
        const data: Record<string, { written: string[]; denom: number; short: string }> = JSON.parse(pill.dataset.tracks ?? '{}');
        for (const [t, d] of Object.entries(data)) {
          const n = now.filter((id) => d.written.includes(id)).length;
          const frac = d.denom ? n / d.denom : 0;
          const text = pill.querySelector<HTMLElement>(`[data-pill-text="${t}"]`);
          if (text) text.textContent = pill.dataset.current ? `${n} / ${d.denom} ${d.short}` : `${n}/${d.denom}`;
          const bar = pill.querySelector<HTMLElement>(`[data-pill-bar="${t}"]`);
          if (bar) bar.style.width = `${frac * 100}%`;
          const cardText = document.querySelector<HTMLElement>(`[data-card-text="${t}"]`);
          if (cardText) cardText.textContent = `${n} / ${d.denom} done`;
          const cardBar = document.querySelector<HTMLElement>(`[data-card-bar="${t}"]`);
          if (cardBar) cardBar.style.width = `${frac * 100}%`;
          if (t === pill.dataset.current) $('ring')?.setAttribute('stroke-dashoffset', String(69.115 * (1 - frac)));
        }
      };
      addEventListener('sd-progress', paintProgress);

      // ---- "new" dot on the AI segment until the AI track has been opened once
      const paintNewDot = () => {
        try {
          if (location.pathname.includes('/learn/ai/')) localStorage.setItem('sd-seen-ai', '1');
          else if (!localStorage.getItem('sd-seen-ai')) $('ai-new-dot')?.classList.remove('hidden');
        } catch {}
      };

      // ---- Review badge: cards due now
      const paintDue = () => {
        const badge = $('review-due');
        if (!badge) return;
        const cards = readJSON<Record<string, { due: number }>>('sd-cards', {});
        const n = Object.values(cards).filter((c) => c.due <= Date.now()).length;
        badge.textContent = String(n);
        badge.classList.toggle('hidden', n === 0);
      };
      addEventListener('sd-mastery', paintDue);

      // ---- Search palette (Ctrl/Cmd+K or "/"). Title rows show instantly, Pagefind body hits append below.
      type Row = { id: string; title: string; number: string; module: string; summary: string; track: 'backend' | 'ai'; soon: boolean; href: string };
      type Body = { url: string; title: string; excerpt: string; track: 'backend' | 'ai'; number: string };
      const NAMES = { backend: 'Backend', ai: 'AI' };
      const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      let rows: Row[] | null = null;
      let pagefind: any = null;
      let pagefindTried = false;
      let body: Body[] = [];
      let bodyFor = '';
      let chip = 'all';
      let active = 0;
      let searchSeq = 0;

      const dlg = () => $<HTMLDialogElement>('search-dialog')!;
      const inputEl = () => $<HTMLInputElement>('search-input')!;
      const listEl = () => $('search-results')!;
      const paintChips = () =>
        document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((c) => {
          const on = c.dataset.chip === chip;
          c.setAttribute('aria-pressed', String(on));
          c.classList.toggle('border-accent', on);
          c.classList.toggle('text-accent', on);
          c.classList.toggle('bg-accent-soft', on);
          c.classList.toggle('text-muted', !on);
        });
      const trackOfUrl = (url: string): 'backend' | 'ai' => (url.includes('/learn/ai/') ? 'ai' : 'backend');
      const group = (t: 'backend' | 'ai') => `<li class="px-3 pb-1 pt-2 font-mono text-xs text-muted" role="presentation">${NAMES[t]}</li>`;

      const render = () => {
        const q = inputEl().value.trim().toLowerCase();
        const hits = (rows ?? [])
          .filter((r) => chip === 'all' || r.track === chip)
          .map((r) => {
            const t = r.title.toLowerCase();
            const score = !q ? 1 : t.startsWith(q) ? 4 : t.includes(q) ? 3 : r.module.toLowerCase().includes(q) ? 2 : r.summary.toLowerCase().includes(q) ? 1 : 0;
            return { r, score: r.soon ? score - 0.5 : score };
          })
          .filter((x) => x.score > 0)
          .sort((a, b) => b.score - a.score || (a.r.track === b.r.track ? 0 : a.r.track === 'backend' ? -1 : 1))
          .slice(0, 12);
        const shown = new Set(hits.filter((h) => !h.r.soon).map((h) => h.r.href));
        const bodyHits = bodyFor === q && q ? body.filter((b) => (chip === 'all' || b.track === chip) && !shown.has(b.url)).slice(0, 8) : [];
        let linkNo = 0;
        let last = '';
        const total = hits.filter((h) => !h.r.soon).length + bodyHits.length;
        active = Math.min(active, Math.max(0, total - 1));
        let html = hits
          .map((h) => {
            const head = chip === 'all' && h.r.track !== last ? group(h.r.track) : '';
            last = h.r.track;
            const inner = `<span class="w-9 shrink-0 text-xs tabular-nums text-muted">${h.r.number}</span><span class="min-w-0 flex-1"><span class="block font-medium">${h.r.title}</span><span class="block truncate text-xs text-muted">${h.r.module}</span></span>`;
            if (h.r.soon) return `${head}<li role="option" aria-disabled="true"><span class="flex items-baseline gap-3 rounded-lg px-3 py-2 text-muted">${inner}<span class="soon-pill">soon</span></span></li>`;
            const on = linkNo++ === active;
            return `${head}<li role="option" aria-selected="${on}"><a href="${h.r.href}" class="flex items-baseline gap-3 rounded-lg px-3 py-2 ${on ? 'bg-accent-soft text-accent' : 'hover:bg-surface'}">${inner}</a></li>`;
          })
          .join('');
        if (bodyHits.length) {
          html += `<li class="mt-2 border-t border-line px-3 pb-1 pt-3 font-mono text-xs text-muted" role="presentation">In the lessons</li>`;
          last = '';
          html += bodyHits
            .map((b) => {
              const head = chip === 'all' && b.track !== last ? group(b.track) : '';
              last = b.track;
              const on = linkNo++ === active;
              return `${head}<li role="option" aria-selected="${on}"><a href="${b.url}" class="flex items-baseline gap-3 rounded-lg px-3 py-2 ${on ? 'bg-accent-soft' : 'hover:bg-surface'}"><span class="w-9 shrink-0 text-xs tabular-nums text-muted">${esc(b.number)}</span><span class="min-w-0 flex-1"><span class="block font-medium ${on ? 'text-accent' : ''}">${esc(b.title)}</span><span class="sd-excerpt mt-0.5 block text-[13px] leading-snug text-muted">${b.excerpt}</span></span></a></li>`;
            })
            .join('');
        }
        listEl().innerHTML = html || `<li class="px-3 py-6 text-center text-muted">${rows ? 'No lessons match.' : 'Loading…'}</li>`;
        listEl().querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
      };

      const searchBody = async () => {
        const q = inputEl().value.trim();
        if (q.length < 2) {
          body = [];
          bodyFor = '';
          return;
        }
        if (!pagefindTried) {
          pagefindTried = true;
          try {
            const base = dlg().dataset.base ?? '';
            pagefind = await import(/* @vite-ignore */ `${location.origin}${base}/pagefind/pagefind.js`);
            await pagefind.options?.({ excerptLength: 18 });
          } catch {
            pagefind = null; // dev server has no index: titles only
          }
        }
        if (!pagefind) return;
        const seq = ++searchSeq;
        try {
          const res = await pagefind.debouncedSearch(q, {}, 120);
          if (!res || seq !== searchSeq) return;
          const data = await Promise.all(res.results.slice(0, 16).map((r: any) => r.data()));
          if (seq !== searchSeq) return;
          const byHref = new Map((rows ?? []).map((r) => [r.href, r]));
          body = data.map((d: any) => {
            const url = d.url.endsWith('/') ? d.url : `${d.url}/`;
            const row = byHref.get(url) ?? byHref.get(d.url);
            return { url, title: row?.title ?? d.meta?.title ?? url, excerpt: d.excerpt, track: trackOfUrl(url), number: row?.number ?? '' };
          });
          bodyFor = q.toLowerCase();
          render();
        } catch {
          body = [];
        }
      };

      const openSearch = async () => {
        const d = dlg();
        if (d.open) return;
        d.showModal();
        inputEl().value = '';
        active = 0;
        body = [];
        bodyFor = '';
        chip = d.dataset.track || 'all';
        paintChips();
        render();
        inputEl().focus();
        if (!rows) {
          try {
            rows = await (await fetch(`${d.dataset.base ?? ''}/search.json`)).json();
          } catch {
            rows = [];
          }
          render();
        }
      };
      const bindSearch = () => {
        const d = $<HTMLDialogElement>('search-dialog');
        if (!once(d)) return;
        document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((c) =>
          c.addEventListener('click', () => {
            chip = c.dataset.chip!;
            active = 0;
            paintChips();
            render();
            inputEl().focus();
          }),
        );
        $('search-btn')?.addEventListener('click', openSearch);
        $('search-btn-sm')?.addEventListener('click', openSearch);
        const input = inputEl();
        input.addEventListener('input', () => {
          active = 0;
          render();
          searchBody();
        });
        input.addEventListener('keydown', (e) => {
          const links = listEl().querySelectorAll('a');
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            active = (active + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % Math.max(1, links.length);
            render();
          } else if (e.key === 'Enter' && links[active]) {
            e.preventDefault();
            (links[active] as HTMLAnchorElement).click();
          }
        });
        // Picking a result navigates with the client router, which replaces the dialog. Close it first so no top layer lingers.
        listEl().addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) d.close();
        });
        d.addEventListener('click', (e) => e.target === d && d.close());
      };
      // One key handler for the whole session: it looks the dialog up fresh, so it survives page swaps.
      addEventListener('keydown', (e) => {
        const typing = (e.target as HTMLElement)?.matches?.('input, textarea, select, [contenteditable]');
        if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) {
          e.preventDefault();
          openSearch();
        }
      });

      // ---- Scroll progress bar and active TOC entry
      let bar: HTMLElement | null = null;
      let links: HTMLAnchorElement[] = [];
      let targets: HTMLElement[] = [];
      const onScroll = () => {
        if (bar) {
          const max = root.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        }
        if (!targets.length) return;
        let current = targets[0];
        for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t;
        // Sub-headings (h3) show only under the section being read, so a long lesson keeps the list short.
        const activeLink = links.find((a) => a.dataset.toc === current.id);
        const openGroup = activeLink?.dataset.tocDepth === '3' ? activeLink.closest('li')?.dataset.tocParent : current.id;
        for (const a of links) {
          const on = a.dataset.toc === current.id;
          a.classList.toggle('text-fg', on);
          a.classList.toggle('font-medium', on);
          a.classList.toggle('border-accent', on);
          a.classList.toggle('text-muted', !on);
          a.classList.toggle('border-transparent', !on);
          const item = a.closest('li');
          if (item?.dataset.tocParent) item.classList.toggle('hidden', item.dataset.tocParent !== openGroup);
        }
        // Keep the active entry visible inside the sidebar without moving the page.
        const panel = activeLink?.closest('aside');
        if (activeLink && panel) {
          const a = activeLink.getBoundingClientRect();
          const p = panel.getBoundingClientRect();
          if (a.top < p.top + 40) panel.scrollTop -= p.top + 40 - a.top;
          else if (a.bottom > p.bottom - 40) panel.scrollTop += a.bottom - (p.bottom - 40);
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
      const bindScroll = () => {
        bar = $('read-progress');
        links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
        targets = links.map((a) => document.getElementById(a.dataset.toc!)).filter((el): el is HTMLElement => el !== null);
        onScroll();
      };

      onPage(() => {
        bindTheme();
        bindDrawer();
        paintSidebar();
        paintProgress();
        paintNewDot();
        paintDue();
        bindSearch();
        bindScroll();
      });
    </script>
  </body>
</html>
