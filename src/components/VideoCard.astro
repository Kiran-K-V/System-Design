---
// One video on the /videos hub. A series links to its own page; a talk opens the theater player.
import { embedUrl, watchUrl, thumbUrl, seriesHref, episodesOf, totalLength, type Video } from '../lib/videos';
import { lessonHref } from '../lib/tracks';

interface Props {
  v: Video;
  /** Lesson the video pairs with, already resolved. */
  pair: { id: string; number: string; title: string };
  /** Position in the "start here" row. Leave out for "go deeper" cards. */
  n?: number;
}

const { v, pair, n } = Astro.props;
const start = n !== undefined;
const eps = v.kind === 'series' ? episodesOf(v) : undefined;
const Thumb = eps ? 'a' : 'button';
const thumbAttrs: Record<string, string> = eps
  ? { href: seriesHref(v), 'aria-label': `Open ${v.title} by ${v.creator}, ${eps.total} episodes` }
  : {
      type: 'button',
      'data-play': '',
      'data-embed': embedUrl(v),
      'data-watch': watchUrl(v),
      'data-title': v.title,
      'data-creator': v.creator,
      'data-why': v.why,
      'data-pair-href': lessonHref(pair.id),
      'data-pair-label': `${pair.number} ${pair.title}`,
      'aria-label': `Play ${v.title} by ${v.creator}`,
    };
---

<article class:list={['vcard', start && 'vcard-start']} data-yt={v.yt} data-kind={v.kind} data-eps={eps?.items.length}>
  <Thumb class="vthumb" {...thumbAttrs}>
    <img src={thumbUrl(v)} alt="" loading="lazy" decoding="async" width="480" height="270" />
    <span class="vplay" aria-hidden="true">
      {
        eps ? (
          <svg width={start ? 22 : 18} height={start ? 22 : 18} viewBox="0 0 24 24" fill="currentColor"><path d="M3 5h12v2H3zM3 9h12v2H3zM3 13h8v2H3zM15 13v6l5-3z" /></svg>
        ) : (
          <svg width={start ? 22 : 18} height={start ? 22 : 18} viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg>
        )
      }
    </span>
    <span class="vkind">{eps ? `${eps.total} episodes · ${totalLength(eps.items)}${eps.total > eps.items.length ? '+' : ''}` : 'Talk'}</span>
    <span class="vdone-badge">✓ {eps ? 'Finished' : 'Watched'}</span>
    {eps && <span class="vprog" aria-hidden="true"><span></span></span>}
  </Thumb>
  <div class:list={['flex flex-1 flex-col', start ? 'p-5' : 'p-4']}>
    {
      start ? (
        <p class="flex items-baseline gap-3">
          <span class="tc-text font-display text-[2rem] italic leading-none">{String(n).padStart(2, '0')}</span>
          <span class="truncate font-mono text-[12px] text-muted">{v.creator}</span>
        </p>
      ) : (
        <p class="flex items-center justify-between gap-2 font-mono text-[11.5px] text-muted">
          <span class="truncate">{v.creator}</span>
          <span class="vlevel" data-level={v.level}>{v.level}</span>
        </p>
      )
    }
    <h3 class:list={['font-semibold leading-snug', start ? 'mt-2 text-[1.1rem] tracking-[-0.015em]' : 'mt-1.5 text-[1rem] tracking-[-0.01em]']}>{v.title}</h3>
    <p class:list={['flex-1 leading-relaxed text-muted', start ? 'mt-2 text-[14px]' : 'mt-1.5 text-[13.5px]']}>{v.why}</p>
    <div class="mt-4 flex items-center justify-between gap-3 border-t border-line pt-3">
      <a href={lessonHref(pair.id)} class="min-w-0 truncate text-[13px] font-medium hover:underline" title={`Pairs with ${pair.number} ${pair.title}`}>
        <span class="text-muted">Pairs with</span> <span class="tc-text">{pair.title}</span>
      </a>
      {
        eps ? (
          <a href={seriesHref(v)} class="vwatch press" data-series-cta>Start series</a>
        ) : (
          <button class="vwatch press" data-watch-toggle aria-pressed="false">Mark watched</button>
        )
      }
    </div>
  </div>
</article>
