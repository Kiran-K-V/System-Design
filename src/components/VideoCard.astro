---
// One video on the /videos hub. A series links to its own page; a talk opens the theater player.
import { embedUrl, watchUrl, thumbUrl, seriesHref, episodesOf, totalLength, type Video } from '../lib/videos';
import { lessonHref } from '../lib/tracks';

interface Props {
  v: Video;
  /** Lesson the video pairs with, already resolved. */
  pair: { id: string; number: string; title: string };
  /** lead: the big first pick. side: stacked next to the lead. row: thumbnail left, for "go deeper". */
  variant: 'lead' | 'side' | 'row';
}

const { v, pair, variant } = Astro.props;
const eps = v.kind === 'series' ? episodesOf(v) : undefined;
const Thumb = eps ? 'a' : 'button';
const thumbAttrs: Record<string, string> = eps
  ? { href: seriesHref(v), 'aria-label': `Open ${v.title} by ${v.creator}, ${eps.total} episodes` }
  : {
      type: 'button',
      'data-play': '',
      'data-embed': embedUrl(v),
      'data-watch': watchUrl(v),
      'data-title': v.title,
      'data-creator': v.creator,
      'data-why': v.why,
      'data-pair-href': lessonHref(pair.id),
      'data-pair-label': `${pair.number} ${pair.title}`,
      'aria-label': `Play ${v.title} by ${v.creator}`,
    };
const icon = variant === 'lead' ? 20 : variant === 'side' ? 16 : 13;
---

<article
  class:list={['vcard', `vc-${variant}`]}
  data-yt={v.yt}
  data-kind={v.kind}
  data-eps={eps?.items.length}
  data-href={eps ? seriesHref(v) : undefined}
  data-title={v.title}
  data-creator={v.creator}
>
  <Thumb class="vthumb" {...thumbAttrs}>
    <img src={thumbUrl(v)} alt="" loading={variant === 'lead' ? 'eager' : 'lazy'} decoding="async" width="480" height="270" />
    <span class="vplay" aria-hidden="true"><svg width={icon} height={icon} viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
    <span class="vkind">{eps ? `${eps.total} videos` : 'Talk'}</span>
    {eps && <span class="vprog" aria-hidden="true"><span></span></span>}
  </Thumb>
  <div class="flex min-w-0 flex-1 flex-col">
    <p class="flex items-center gap-2 text-[12.5px] text-muted">
      <span class="truncate">{v.creator}</span>
      {variant !== 'lead' && <span class="vlevel shrink-0" data-level={v.level}>· {v.level}</span>}
    </p>
    <h3
      class:list={[
        'mt-1 font-semibold tracking-[-0.015em] text-fg',
        variant === 'lead' ? 'text-[1.4rem] leading-tight' : 'text-[1rem] leading-snug',
      ]}
    >
      {v.title}
    </h3>
    <p class:list={['mt-1.5 leading-relaxed text-muted', variant === 'lead' ? 'max-w-[60ch] text-[14.5px]' : 'vclamp text-[13.5px]']}>{v.why}</p>
    {variant === 'lead' && eps && <p class="mt-2 font-mono text-[12px] text-muted">{totalLength(eps.items)}{eps.total > eps.items.length ? '+' : ''} in total</p>}
    <div class="mt-3 flex items-center justify-between gap-3">
      <a href={lessonHref(pair.id)} class="min-w-0 truncate text-[13px] text-muted hover:text-fg" title={`Pairs with ${pair.number} ${pair.title}`}>
        Pairs with <span class="font-medium" style="color: var(--tc)">{pair.number}</span>
      </a>
      {
        eps ? (
          <a href={seriesHref(v)} class="vwatch press" data-series-cta>Start</a>
        ) : (
          <button class="vwatch press" data-watch-toggle aria-pressed="false">Mark watched</button>
        )
      }
    </div>
  </div>
</article>
