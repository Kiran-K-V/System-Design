---
// A compact link to one video, for lesson pages and track homes. The /videos hub uses VideoCard.
import { videoHref, thumbUrl, episodesOf, totalLength, type Video } from '../lib/videos';

interface Props {
  v: Video;
  /** row: thumbnail left, for a lesson. tile: thumbnail on top, for a shelf of three. */
  layout: 'row' | 'tile';
}

const { v, layout } = Astro.props;
const eps = v.kind === 'series' ? episodesOf(v) : undefined;
const meta = eps ? `${eps.total} videos, ${totalLength(eps.items)}${eps.total > eps.items.length ? '+' : ''}` : 'Talk';
---

<a href={videoHref(v)} class:list={['watch-card group', `wc-${layout}`]} style={`--tc: var(--c-${v.track})`}>
  <span class="wc-thumb">
    <img src={thumbUrl(v)} alt="" loading="lazy" decoding="async" width="480" height="270" />
    <span class="wc-play" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
  </span>
  <span class="min-w-0">
    <span class="block truncate text-[12.5px] text-muted">{v.creator}</span>
    <span class="mt-0.5 block font-semibold leading-snug tracking-[-0.01em] group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{v.title}</span>
    <span class="mt-1 block font-mono text-[11.5px] text-muted">{meta}</span>
  </span>
</a>
