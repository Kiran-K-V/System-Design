---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { loadSyllabus } from '../lib/lessons';
import { tracks, trackHref, lessonHref, levelOf, type TrackId } from '../lib/tracks';
import Table from './lesson/Table.astro';
import { tslug } from '../lib/page';

interface Props {
  entry: CollectionEntry<'lessons'>;
  track: TrackId;
}

const { entry, track } = Astro.props;
const { flat } = await loadSyllabus();
const { Content, headings } = await render(entry);

const self = flat.find((l) => l.id === entry.id)!;
// Prev and next stay inside the track.
const written = flat.filter((l) => l.written && l.track === track);
const pos = written.findIndex((l) => l.id === entry.id);
const prev = written[pos - 1];
const next = written[pos + 1];
const slug = tslug(entry.id);
const moduleIds = flat.filter((l) => l.moduleSlug === self.moduleSlug && l.written).map((l) => l.id);
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 220));
const interactive = /client:(visible|load|idle)/.test(entry.body ?? '');
const level = levelOf(track, self.moduleIndex);
const order = (id: string) => flat.findIndex((l) => l.id === id);
const requires = entry.data.requires.map((r) => flat.find((l) => l.id === r)!).sort((x, y) => order(x.id) - order(y.id));
---

<Layout title={self.title} description={entry.data.summary} track={track} currentId={entry.id} headings={headings}>
  <article class="mx-auto max-w-[700px]" data-pagefind-body>
    <header class="border-b border-line pb-8">
      <div class="flex items-baseline justify-between gap-4 font-mono text-[12px] text-muted">
        <nav class="flex min-w-0 items-baseline gap-2" aria-label="Breadcrumb" data-pagefind-ignore>
          <a href={trackHref(track)} class="hover:text-fg">{tracks[track].short}</a>
          <span aria-hidden="true">/</span>
          <span class="truncate">{self.moduleTitle}</span>
        </nav>
        <span class="hidden shrink-0 items-baseline gap-4 sm:flex" data-pagefind-ignore>
          {prev && <a href={lessonHref(prev.id)} class="hover:text-fg" aria-label={`Previous: ${prev.title}`}>← {prev.number}</a>}
          {next && <a href={lessonHref(next.id)} class="hover:text-fg" aria-label={`Next: ${next.title}`}>{next.number} →</a>}
        </span>
      </div>

      <p transition:name={`num-${slug}`} class="mt-10 font-display text-[clamp(4rem,9vw,6rem)] italic leading-[0.75] tracking-[-0.02em] text-accent" aria-hidden="true">{self.number}</p>
      <h1 transition:name={`title-${slug}`} class="mt-4 text-[clamp(2.4rem,5.5vw,3.4rem)] font-semibold leading-[1.02] tracking-[-0.04em]">
        <span class="sr-only">Lesson {self.number}: </span><span data-pagefind-meta="title">{self.title}</span>
      </h1>
      <p class="mt-5 max-w-[58ch] text-[1.125rem] leading-[1.6] text-muted">{entry.data.summary}</p>

      {
        requires.length > 0 && (
          <nav class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px]" aria-label="Builds on" data-pagefind-ignore>
            <span class="font-mono text-[12px] text-muted">builds on</span>
            {requires.map((r) => (
              <a href={lessonHref(r.id)} class="group inline-flex items-baseline gap-1.5 text-muted hover:text-fg" style={r.track !== track ? `--tc: var(--c-${r.track})` : undefined}>
                {r.track !== track && <span class="track-chip">{tracks[r.track].short}</span>}
                <span class:list={['font-mono text-[12px] tabular-nums', r.track !== track && 'tc-text']}>{r.number}</span>
                <span class="underline decoration-line underline-offset-4 group-hover:decoration-accent" style={r.track !== track ? 'text-decoration-color: var(--tc)' : undefined}>{r.title}</span>
              </a>
            ))}
            <span class="flex items-center text-line" aria-hidden="true">
              <span class="h-px w-8 bg-current"></span>
              <svg width="7" height="10" viewBox="0 0 7 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l4.5 4L1 9" /></svg>
            </span>
            <span class="inline-flex items-baseline gap-1.5 font-medium text-fg" aria-current="page">
              <span class="relative top-[-1px] h-2 w-2 self-center rounded-full bg-accent"></span>
              <span class="font-mono text-[12px] tabular-nums">{self.number}</span>
              {self.title}
            </span>
          </nav>
        )
      }

      <p class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-[12px] text-muted" data-pagefind-ignore>
        <span>{minutes} min read</span>
        {interactive && (<><span aria-hidden="true">·</span><span>interactive</span></>)}
        <span aria-hidden="true">·</span>
        <span>{level.toLowerCase()}</span>
      </p>
    </header>

    <div class="prose mt-10 dark:prose-invert">
      <Content components={{ table: Table }} />
    </div>

    <div class="mt-14 flex justify-center" data-pagefind-ignore>
      <button
        id="complete-btn"
        data-id={entry.id}
        data-track={track}
        data-module-ids={JSON.stringify(moduleIds)}
        class="press rounded-md border border-line px-4 py-2 text-sm font-medium hover:border-fg/30"
      >
        Mark complete
      </button>
    </div>

    <nav class="mt-10 grid grid-cols-2 gap-6 border-t border-line pt-6" aria-label="Lesson navigation" data-pagefind-ignore>
      <div>
        {
          prev && (
            <a href={lessonHref(prev.id)} class="group block">
              <span class="font-mono text-[12px] text-muted">← Previous · {prev.number}</span>
              <span class="mt-1.5 block text-[1.05rem] font-medium leading-snug tracking-[-0.01em] group-hover:text-accent">{prev.title}</span>
            </a>
          )
        }
      </div>
      <div class="text-right">
        {
          next && (
            <a href={lessonHref(next.id)} class="group block">
              <span class="font-mono text-[12px] text-muted">Next · {next.number} →</span>
              <span class="mt-1.5 block text-[1.05rem] font-medium leading-snug tracking-[-0.01em] group-hover:text-accent">{next.title}</span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Layout>

<script>
  import { onPage, once } from '../lib/page';
  import { recordActivity } from '../lib/mastery';
  import { celebrate } from '../lib/confetti';

  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
    } catch {
      return [];
    }
  };
  const paint = () => {
    const btn = document.getElementById('complete-btn');
    if (!btn) return;
    const id = btn.dataset.id!;
    const done = read().includes(id);
    btn.textContent = done ? '✓ Completed' : 'Mark complete';
    btn.classList.toggle('text-ok', done);
    document.querySelector(`[data-lesson="${CSS.escape(id)}"] .done-mark`)?.classList.toggle('hidden', !done);
  };
  onPage(() => {
    const btn = document.getElementById('complete-btn');
    if (!btn) return;
    const id = btn.dataset.id!;
    try {
      localStorage.setItem('sd-last', JSON.stringify({ id, track: btn.dataset.track, at: Date.now() }));
    } catch {}
    if (once(btn)) {
      btn.addEventListener('click', () => {
        const set = new Set(read());
        const adding = !set.has(id);
        const moduleIds: string[] = JSON.parse(btn.dataset.moduleIds ?? '[]');
        const wasModuleDone = moduleIds.every((m) => set.has(m));
        adding ? set.add(id) : set.delete(id);
        try {
          localStorage.setItem('sd-progress', JSON.stringify([...set]));
        } catch {}
        if (adding) recordActivity();
        paint();
        dispatchEvent(new Event('sd-progress'));
        // Reward only the lesson that finishes the module
        if (adding && !wasModuleDone && moduleIds.every((m) => set.has(m))) celebrate();
      });
    }
    paint();
  });
</script>
