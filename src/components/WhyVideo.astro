---
// "?" button that explains why a video is on the list: the sourced reason, its public rating, and its lesson.
// The popover is placed next to the button by src/lib/whyPopover.ts.
import { statsOf, statsChecked, type Video } from '../lib/videos';

interface Props {
  v: Video;
  pair: { href: string; label: string };
}

const { v, pair } = Astro.props;
const id = `why-${v.yt}`;
const st = statsOf(v);
const n = (x: number) => x.toLocaleString('en');
---

<button class="vwhy" popovertarget={id} aria-label={`Why ${v.title} is on this list`} title="Why it's here">?</button>
<div id={id} popover="auto" class="vwhy-pop" role="dialog" aria-label={`Why ${v.title} is here`}>
  <p class="text-[13px] font-semibold text-fg">Why it's here</p>
  <p class="mt-1.5 text-[13px] leading-relaxed text-[var(--body)]">
    {v.picked ? v.picked.text : v.why}
    {v.picked && <a href={v.picked.url} target="_blank" rel="noopener" class="ml-1 whitespace-nowrap text-muted underline decoration-1 underline-offset-2 hover:text-fg">Source ↗</a>}
  </p>
  {
    st && (
      <p class="mt-3 text-[13px] leading-relaxed text-[var(--body)]">
        On YouTube, {v.kind === 'series' ? 'episode 1 has' : 'it has'} <span class="font-semibold text-fg">{n(st.views)}</span> views
        {st.likes > 0 && <> and <span class="font-semibold text-fg">{n(st.likes)}</span> likes</>}.{' '}
        <a href={`https://www.youtube.com/watch?v=${st.video}`} target="_blank" rel="noopener" class="whitespace-nowrap text-muted underline decoration-1 underline-offset-2 hover:text-fg">Checked {statsChecked} ↗</a>
      </p>
    )
  }
  {
    v.rating && (
      <p class="mt-3 text-[13px] text-[var(--body)]">
        <span class="vstar" aria-hidden="true">★</span> <span class="font-semibold text-fg">{v.rating.value.toFixed(1)}</span> from {v.rating.count} learner reviews on{' '}
        <a href={v.rating.url} target="_blank" rel="noopener" class="underline decoration-1 underline-offset-2 hover:text-fg">{v.rating.site} ↗</a>
      </p>
    )
  }
  <p class="mt-3 border-t border-line pt-3 text-[13px] text-muted">
    Pairs with <a href={pair.href} class="font-medium hover:underline" style="color: var(--tc)">{pair.label}</a>
  </p>
</div>
