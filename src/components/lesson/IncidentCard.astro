---
// A real, publicly documented outage that the lesson's idea would have prevented.
// Body (slot) tells what happened. `missing` names the idea from this lesson. Cite only the primary postmortem.
interface Props {
  id?: string;
  org: string;
  date: string;
  title: string;
  cost: string;
  missing: string;
  source: string;
  sourceLabel: string;
}

const { id = 'incident', org, date, title, cost, missing, source, sourceLabel } = Astro.props;
---

<aside
  id={id}
  class="not-prose my-8 scroll-mt-20 rounded-xl border px-4 py-4"
  style="background: color-mix(in srgb, var(--bad) 5%, var(--bg)); border-color: color-mix(in srgb, var(--bad) 28%, var(--border));"
>
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] font-semibold" style="color: var(--bad)">
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.8 1.8 17h16.4L10 2.8ZM10 8v4.2M10 14.6v.1"></path></svg>
    Real incident
    <span class="font-normal text-[var(--muted)]">{org} · {date}</span>
  </p>
  <p class="mt-2 text-[1.05rem] font-semibold leading-snug text-[var(--fg)]">{title}</p>
  <div class="mt-2 text-[0.95rem] leading-relaxed text-[var(--body)] [&_a]:underline [&_code]:rounded [&_code]:border [&_code]:border-[var(--border)] [&_code]:bg-[var(--bg)] [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.85em] [&_li+li]:mt-1 [&_ol]:mt-1 [&_ol]:list-decimal [&_ol]:pl-5 [&_p+p]:mt-2 [&_strong]:text-[var(--fg)] [&_ul]:mt-1 [&_ul]:list-disc [&_ul]:pl-5">
    <slot />
  </div>
  <dl class="mt-3 grid gap-x-4 gap-y-1.5 border-t pt-3 text-[0.9rem] leading-relaxed sm:grid-cols-[auto_1fr]" style="border-color: color-mix(in srgb, var(--bad) 20%, var(--border));">
    <dt class="font-semibold text-[var(--fg)]">Cost</dt>
    <dd class="text-[var(--body)]">{cost}</dd>
    <dt class="font-semibold text-[var(--fg)]">The missing idea</dt>
    <dd class="text-[var(--body)]">{missing}</dd>
  </dl>
  <p class="mt-3 text-[0.85rem] text-[var(--muted)]">
    Source: <a class="underline hover:text-[var(--fg)]" href={source} target="_blank" rel="noopener">{sourceLabel}</a>
  </p>
</aside>
