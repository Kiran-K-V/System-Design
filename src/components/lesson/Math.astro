---
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
  block?: boolean;
}
const { tex, block = false } = Astro.props;
const html = katex.renderToString(tex, { displayMode: block, throwOnError: false, output: 'htmlAndMathml' });
const Tag = block ? 'div' : 'span';
---
<Tag class={block ? 'sd-math sd-math-block' : 'sd-math'} set:html={html} />
<style is:global>
  .sd-math, .sd-math .katex { color: inherit; }
  .sd-math-block { margin: 1.1rem 0; overflow-x: auto; overflow-y: hidden; max-width: 100%; }
  .sd-math-block .katex-display { margin: 0; }
  .sd-math .katex { font-size: 1.05em; }
</style>
