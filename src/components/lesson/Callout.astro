---
interface Props {
  type: 'tip' | 'mistake' | 'deep';
  title?: string;
}

const STYLE = {
  tip: {
    label: 'Interview tip',
    color: 'var(--accent)',
    icon: 'M10 2.5a5 5 0 0 0-2.9 9.1c.5.4.9 1 .9 1.7V14h4v-.7c0-.7.4-1.3.9-1.7A5 5 0 0 0 10 2.5ZM8.2 16.5h3.6',
  },
  mistake: {
    label: 'Common mistake',
    color: 'var(--bad)',
    icon: 'M10 2.8a7.2 7.2 0 1 0 0 14.4 7.2 7.2 0 0 0 0-14.4ZM7.6 7.6l4.8 4.8M12.4 7.6l-4.8 4.8',
  },
  deep: {
    label: 'Deep dive',
    color: 'var(--warn)',
    icon: 'M10 3 2.8 7l7.2 4 7.2-4L10 3ZM2.8 10.5 10 14.5l7.2-4M2.8 13.8 10 17.8l7.2-4',
  },
} as const;

const { type, title } = Astro.props;
const s = STYLE[type];
---

<aside
  class="not-prose my-7 rounded-xl border px-4 py-3.5"
  style={`background: color-mix(in srgb, ${s.color} 6%, var(--bg)); border-color: color-mix(in srgb, ${s.color} 28%, var(--border));`}
>
  <p class="flex items-center gap-2 text-[13px] font-semibold" style={`color: ${s.color}`}>
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon}></path></svg>
    {title ?? s.label}
  </p>
  <div class="mt-1.5 text-[0.95rem] leading-relaxed text-[var(--body)] [&_code]:rounded [&_code]:border [&_code]:border-[var(--border)] [&_code]:bg-[var(--bg)] [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.85em] [&_p+p]:mt-2 [&_strong]:text-[var(--fg)] [&_ul]:mt-1 [&_ul]:list-disc [&_ul]:pl-5">
    <slot />
  </div>
</aside>
