---
// A card that points at a lesson in the other track. The body slot holds a 3 to 5 sentence summary.
import { loadSyllabus } from '../lib/lessons';
import { tracks, lessonHref } from '../lib/tracks';

interface Props {
  /** Full lesson id, for example "04-data/consensus" or "ai/a5-inference/kv-cache". */
  id: string;
}

const { id } = Astro.props;
const { flat } = await loadSyllabus();
const target = flat.find((l) => l.id === id);
if (!target) throw new Error(`CrossTrackLink: unknown lesson "${id}"`);
const track = tracks[target.track];
---

<aside class="not-prose my-8 rounded-xl border border-line bg-surface p-5" style={`--tc: var(--c-${target.track}); border-left: 3px solid var(--tc)`}>
  <p class="flex flex-wrap items-center gap-2">
    <span class="track-chip">{track.short}</span>
    <span class="font-mono text-[12px] tabular-nums tc-text">{target.number}</span>
  </p>
  <p class="mt-2 text-[1.1rem] font-semibold leading-snug tracking-[-0.01em]">{target.title}</p>
  <div class="mt-2 text-[15px] leading-relaxed text-muted"><slot /></div>
  {
    target.written ? (
      <a href={lessonHref(target.id)} class="press mt-3 inline-flex items-center gap-1.5 text-sm font-medium tc-text underline decoration-line underline-offset-[6px]">
        Read the lesson <span aria-hidden="true">→</span>
      </a>
    ) : (
      <p class="mt-3 font-mono text-[12px] text-muted">coming soon</p>
    )
  }
</aside>
