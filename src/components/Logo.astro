---
// Uptime mark: three chevrons climbing. "Up" is the name, the stack is the lessons, the lit top one is you.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="var(--fg)" />
  <path d="M7.5 24 16 17.5 24.5 24" fill="none" stroke="var(--muted)" stroke-opacity="0.55" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M7.5 19 16 12.5 24.5 19" fill="none" stroke="var(--bg)" stroke-opacity="0.85" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M7.5 14 16 7.5 24.5 14" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
</svg>
