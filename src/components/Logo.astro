---
// Groundwork mark: a stack of layers. The top layer is lit; the ones below it are the lessons it rests on.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id="gw-mark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4d8dff" />
      <stop offset="1" stop-color="#7c5cf0" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill="var(--fg)" />
  <path d="M6.5 19.5 16 24.5l9.5-5" fill="none" stroke="var(--muted)" stroke-opacity="0.7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M6.5 15 16 20l9.5-5" fill="none" stroke="var(--bg)" stroke-opacity="0.75" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M16 5.5 25.5 10.5 16 15.5 6.5 10.5z" fill="url(#gw-mark)" stroke="url(#gw-mark)" stroke-width="1.5" stroke-linejoin="round" />
</svg>
