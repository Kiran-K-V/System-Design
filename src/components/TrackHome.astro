---
// Shared track home: hero, course map, legend, module grid by part. Route files stay thin.
import Layout from '../layouts/Layout.astro';
import CourseMap from './lesson/CourseMap';
import AiCourseMap from './lesson/AiCourseMap';
import { loadSyllabus } from '../lib/lessons';
import { tracks, lessonHref, type TrackId } from '../lib/tracks';

interface Props {
  track: TrackId;
}

const { track } = Astro.props;
const t = tracks[track];
const syl = await loadSyllabus();
const { modules, flat } = syl.tracks[track];
const byId = new Map(syl.flat.map((l) => [l.id, l]));
const ready = flat.filter((l) => l.written);
const first = ready[0];
---

<Layout title={t.name} description={t.tagline} track={track}>
  <div class="mx-auto max-w-[860px]">
    <p class="flex items-center gap-3 font-mono text-[12px] tracking-[0.02em] text-muted">
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      {t.name}
    </p>
    <h1 class="mt-6 max-w-[16ch] text-[clamp(2.5rem,6.5vw,4.25rem)] font-semibold leading-[0.97] tracking-[-0.045em]">
      {track === 'backend' ? (<>Systems that stay <em class="font-display text-[1.12em] font-normal italic leading-[0.8] text-accent">up.</em></>) : (<>Systems built on <em class="font-display text-[1.12em] font-normal italic leading-[0.8] text-accent">models.</em></>)}
    </h1>
    <p class="mt-7 max-w-[56ch] text-[1.075rem] leading-[1.65] text-muted">
      {t.tagline}
      {
        track === 'backend'
          ? ' Each lesson builds only on the lessons before it, with a diagram you can step through.'
          : ' Every lesson is planned and ordered. Lessons arrive module by module, and each one links back to the backend lesson it builds on.'
      }
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
      {
        first && (
          <a href={lessonHref(first.id)} class="press group inline-flex items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg hover:opacity-90">
            Start with {first.number} {first.title}
            <svg class="transition-transform duration-200 group-hover:translate-x-0.5" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" /></svg>
          </a>
        )
      }
      <a href="#roadmap" class="press text-sm font-medium underline decoration-line decoration-1 underline-offset-[6px] hover:decoration-accent">Browse the modules</a>
      <span class="font-mono text-[12px] tabular-nums text-muted">{modules.length} modules · {ready.length}/{flat.length} lessons ready</span>
    </div>

    <figure class="mt-14 hidden sm:block" aria-label={`How the ${t.short} track stacks`}>
      {track === 'backend' ? <CourseMap /> : <AiCourseMap />}
    </figure>

    <section id="roadmap" class="mt-16 scroll-mt-20">
      <h2 class="flex items-center gap-3 font-mono text-[12px] font-normal text-muted">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        roadmap
      </h2>
      <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[12px] text-muted" aria-hidden="true">
        <span class="flex items-center gap-2"><span class="rm-key rm-key-done"></span>done</span>
        <span class="flex items-center gap-2"><span class="rm-key"></span>ready</span>
        <span class="flex items-center gap-2"><span class="rm-key rm-key-soon"></span>coming soon</span>
      </p>

      {
        t.parts.map((part) => (
          <div class="mt-10">
            <h2 class="text-[1.35rem] font-semibold tracking-[-0.025em]">{part.title}</h2>
            <ol class="mt-4 grid items-start gap-3 sm:grid-cols-2">
              {part.modules.map((mi) => {
                const m = modules[mi];
                const r = m.lessons.filter((l) => l.written);
                return (
                  <li>
                    <details id={`module-${m.label}`} class="mod-card group scroll-mt-20" data-mod data-ids={JSON.stringify(r.map((l) => l.id))} data-soon={r.length === 0}>
                      <summary>
                        <span class="flex items-start gap-3">
                          <span class:list={['font-display w-9 shrink-0 text-[2rem] italic leading-[0.85]', r.length ? 'text-accent' : 'text-muted']} aria-hidden="true">{m.label}</span>
                          <span class="min-w-0 flex-1">
                            <h3 class="text-[1rem] font-semibold leading-snug tracking-[-0.015em]"><span class="sr-only">Module {m.label}: </span>{m.title}</h3>
                            <span class="mt-1 block font-mono text-[12px] tabular-nums text-muted">
                              <span data-mod-count>{r.length === 0 ? `soon · ${m.lessons.length} lessons planned` : `0/${r.length} done · ${m.lessons.length} lessons`}</span>
                            </span>
                          </span>
                          <svg class="mt-1.5 shrink-0 text-muted transition-transform group-open:rotate-90" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 2.5L8 6l-3.5 3.5" /></svg>
                        </span>
                        {r.length > 0 && <span class="bar mt-3 block" aria-hidden="true"><span data-mod-bar></span></span>}
                      </summary>
                      <ul class="mod-lessons mt-3">
                        {m.lessons.map((l) => (
                          <li>
                            <span class="w-9 shrink-0 font-mono text-[12px] tabular-nums text-muted">{l.number}</span>
                            {l.written ? (
                              <a href={lessonHref(l.id)} data-lesson={l.id} class="flex min-w-0 flex-1 items-baseline gap-2">
                                <span class="lt min-w-0 flex-1 transition-colors">{l.title}</span>
                                <span class="done-mark hidden" aria-label="Completed"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.4l2.6 2.6L11 4.6" /></svg></span>
                              </a>
                            ) : (
                              <span class="flex min-w-0 flex-1 items-baseline gap-2 text-muted"><span class="min-w-0 flex-1">{l.title}</span><span class="soon-pill">soon</span></span>
                            )}
                            {l.crossRequires.map((id) => byId.get(id)).filter(Boolean).map((x) => (
                              <span class="track-chip w-full sm:w-auto" style={`--tc: var(--c-${x!.track})`}>↔ {tracks[x!.track].short} {x!.number}</span>
                            ))}
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                );
              })}
            </ol>
          </div>
        ))
      }
    </section>
  </div>
</Layout>

<script>
  // Mark finished lessons and fill each module's bar. Progress lives in this browser only.
  const paint = () => {
    let done: string[] = [];
    try {
      done = JSON.parse(localStorage.getItem('sd-progress') ?? '[]');
    } catch {}
    document.querySelectorAll<HTMLElement>('[data-mod]').forEach((el) => {
      const ids: string[] = JSON.parse(el.dataset.ids ?? '[]');
      const n = ids.filter((id) => done.includes(id)).length;
      const count = el.querySelector('[data-mod-count]');
      if (ids.length && count) count.textContent = count.textContent!.replace(/^\d+\/\d+/, `${n}/${ids.length}`);
      const bar = el.querySelector<HTMLElement>('[data-mod-bar]');
      if (bar) bar.style.width = ids.length ? `${(n / ids.length) * 100}%` : '0';
      el.dataset.unfinished = String(ids.length > 0 && n < ids.length);
      el.querySelectorAll<HTMLElement>('[data-lesson]').forEach((a) => a.querySelector('.done-mark')?.classList.toggle('hidden', !done.includes(a.dataset.lesson!)));
    });
  };
  paint();
  addEventListener('sd-progress', paint);

  // Open the module named in the URL, else the first one with unfinished lessons.
  const byHash = () => {
    const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    return el instanceof HTMLDetailsElement ? el : null;
  };
  const target = byHash();
  if (target) target.open = true;
  else if (!document.querySelector('[data-mod][open]')) document.querySelector<HTMLDetailsElement>('[data-mod][data-unfinished="true"]')?.setAttribute('open', '');
  addEventListener('hashchange', () => {
    const el = byHash();
    if (el) el.open = true;
  });
</script>
