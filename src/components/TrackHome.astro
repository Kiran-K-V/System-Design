---
// Shared track home: hero, course map, legend, roadmap spine with a checkpoint note per part. Route files stay thin.
import Layout from '../layouts/Layout.astro';
import CourseMap from './lesson/CourseMap';
import AiCourseMap from './lesson/AiCourseMap';
import { loadSyllabus } from '../lib/lessons';
import { tracks, lessonHref, type TrackId } from '../lib/tracks';
import { tslug } from '../lib/page';

interface Props {
  track: TrackId;
}

const { track } = Astro.props;
const t = tracks[track];
const syl = await loadSyllabus();
const { modules, flat } = syl.tracks[track];
const byId = new Map(syl.flat.map((l) => [l.id, l]));
const ready = flat.filter((l) => l.written);
const first = ready[0];
---

<Layout title={t.name} description={t.tagline} track={track}>
  <div class="mx-auto max-w-[860px]">
    <p class="flex items-center gap-3 font-mono text-[12px] tracking-[0.02em] text-muted">
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      {t.name}
    </p>
    <h1 class="mt-6 max-w-[16ch] text-[clamp(2.5rem,6.5vw,4.25rem)] font-semibold leading-[0.97] tracking-[-0.045em]">
      {track === 'backend' ? (<>Systems that stay <em class="font-display text-[1.12em] font-normal italic leading-[0.8] text-accent">up.</em></>) : (<>Systems built on <em class="font-display text-[1.12em] font-normal italic leading-[0.8] text-accent">models.</em></>)}
    </h1>
    <p class="mt-7 max-w-[56ch] text-[1.075rem] leading-[1.65] text-muted">
      {t.tagline}
      {
        track === 'backend'
          ? ' Each lesson builds only on the lessons before it, with a diagram you can step through.'
          : ' Every lesson is planned and ordered. Lessons arrive module by module, and each one links back to the backend lesson it builds on.'
      }
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
      {
        first && (
          <a href={lessonHref(first.id)} class="press group inline-flex items-center gap-2 rounded-md bg-fg px-4 py-2.5 text-sm font-medium text-bg hover:opacity-90">
            Start with {first.number} {first.title}
            <svg class="transition-transform duration-200 group-hover:translate-x-0.5" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" /></svg>
          </a>
        )
      }
      <a href="#roadmap" class="press text-sm font-medium underline decoration-line decoration-1 underline-offset-[6px] hover:decoration-accent">Browse the modules</a>
      <span class="font-mono text-[12px] tabular-nums text-muted">{modules.length} modules · {ready.length}/{flat.length} lessons ready</span>
    </div>

    <figure class="mt-14 hidden sm:block" aria-label={`How the ${t.short} track stacks`}>
      {track === 'backend' ? <CourseMap /> : <AiCourseMap />}
    </figure>

    <section id="roadmap" class="mt-16 scroll-mt-20">
      <h2 class="flex items-center gap-3 font-mono text-[12px] font-normal text-muted">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        roadmap
      </h2>
      <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[12px] text-muted" aria-hidden="true">
        <span class="flex items-center gap-2"><span class="rm-key rm-key-done"></span>done</span>
        <span class="flex items-center gap-2"><span class="rm-key"></span>ready</span>
        <span class="flex items-center gap-2"><span class="rm-key rm-key-soon"></span>coming soon</span>
        <span class="flex items-center gap-2"><span class="rm-key rm-key-note"></span>checkpoint</span>
      </p>

      <ol class="roadmap mt-10">
        {
          t.parts.map((part, pi) => {
            const partIds = part.modules.flatMap((mi) => modules[mi].lessons.filter((l) => l.written).map((l) => l.id));
            return (
              <>
                <li class="rm-part">
                  <h2>{part.title}</h2>
                </li>
                {part.modules.map((mi) => {
                  const m = modules[mi];
                  const r = m.lessons.filter((l) => l.written);
                  const half = Math.ceil(m.lessons.length / 2);
                  const sides = [m.lessons.slice(0, half), m.lessons.slice(half)];
                  return (
                    <li id={`module-${m.label}`} class="rm-module scroll-mt-20" data-mod data-ids={JSON.stringify(r.map((l) => l.id))}>
                      <div class:list={['rm-node', r.length === 0 && 'rm-node-soon']}>
                        <span class:list={['font-display text-[1.9rem] italic leading-[0.8]', r.length ? 'text-accent' : 'text-muted']} aria-hidden="true">{m.label}</span>
                        <span class="min-w-0 flex-1">
                          <h3 class="text-[1rem] font-semibold leading-tight tracking-[-0.015em]"><span class="sr-only">Module {m.label}: </span>{m.title}</h3>
                          <span class="mt-1 block font-mono text-[11px] tabular-nums text-muted">
                            <span data-mod-count>{r.length === 0 ? `soon · ${m.lessons.length} planned` : `0/${r.length} done`}</span>
                          </span>
                          {r.length > 0 && <span class="bar mt-2 block" aria-hidden="true"><span data-mod-bar></span></span>}
                        </span>
                      </div>
                      {sides.map(
                        (side, k) =>
                          side.length > 0 && (
                            <ul class:list={['rm-side', k === 0 ? 'rm-left' : 'rm-right']}>
                              {side.map((l) => (
                                <li class="rm-leaf">
                                  {l.written ? (
                                    <a href={lessonHref(l.id)} class="rm-lesson" data-lesson={l.id}>
                                      <span transition:name={`num-${tslug(l.id)}`} class="rm-num">{l.number}</span>
                                      <span class="rm-title">
                                        <span transition:name={`title-${tslug(l.id)}`}>{l.title}</span>
                                        {l.crossRequires.map((id) => byId.get(id)).filter(Boolean).map((x) => (
                                          <span class="rm-cross" style={`--tc: var(--c-${x!.track})`}>↔ {tracks[x!.track].short} {x!.number}</span>
                                        ))}
                                      </span>
                                      <svg class="rm-check" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="done"><path d="M2.5 6.2 5 8.6l4.5-5" /></svg>
                                    </a>
                                  ) : (
                                    <span class="rm-lesson rm-lesson-soon">
                                      <span class="rm-num">{l.number}</span>
                                      <span class="rm-title">{l.title}</span>
                                    </span>
                                  )}
                                </li>
                              ))}
                            </ul>
                          ),
                      )}
                    </li>
                  );
                })}
                <li class="rm-note-row">
                  <aside class="rm-note" data-note={`${track}-${pi}`} data-ids={JSON.stringify(partIds)} aria-label={`Checkpoint: ${part.title}`} style={`--tilt: ${pi % 2 ? 1 : -1}deg`}>
                    <p class="rm-note-head">✎ checkpoint · {part.title}</p>
                    <p class="rm-note-lead">At this point you can:</p>
                    <ul>
                      {part.can.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                    <p class="rm-note-next">
                      <span>{pi === t.parts.length - 1 ? 'After this:' : 'Next:'}</span> {part.next}
                    </p>
                    <span class="rm-stamp" data-note-stamp aria-hidden="true">{partIds.length ? 'locked' : 'soon'}</span>
                  </aside>
                </li>
              </>
            );
          })
        }
      </ol>
    </section>
  </div>
</Layout>

<script>
  import { onPage } from '../lib/page';
  import { loadDone } from '../lib/mastery';
  import { celebrate } from '../lib/confetti';

  const EARNED = 'sd-earned';
  const readEarned = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(EARNED) ?? '[]');
    } catch {
      return [];
    }
  };

  // Paint progress on the spine. Progress lives in this browser only.
  const paint = () => {
    const done = new Set(loadDone());
    const ids = (el: HTMLElement): string[] => JSON.parse(el.dataset.ids ?? '[]');

    document.querySelectorAll<HTMLElement>('[data-mod]').forEach((el) => {
      const own = ids(el);
      const n = own.filter((id) => done.has(id)).length;
      const count = el.querySelector('[data-mod-count]');
      if (own.length && count) count.textContent = `${n}/${own.length} done`;
      const bar = el.querySelector<HTMLElement>('[data-mod-bar]');
      if (bar) bar.style.width = own.length ? `${(n / own.length) * 100}%` : '0';
    });

    // Done marks, and "you are here" on the first ready lesson not done yet.
    let here = false;
    document.querySelectorAll<HTMLElement>('[data-lesson]').forEach((a) => {
      const isDone = done.has(a.dataset.lesson!);
      a.classList.toggle('is-done', isDone);
      a.classList.toggle('is-here', !isDone && !here);
      if (!isDone) here = true;
    });

    // A checkpoint is earned when every ready lesson in its part is done. Celebrate once per checkpoint.
    const seen = readEarned();
    let fresh = false;
    document.querySelectorAll<HTMLElement>('[data-note]').forEach((note) => {
      const own = ids(note);
      const earned = own.length > 0 && own.every((id) => done.has(id));
      note.classList.toggle('is-earned', earned);
      const stamp = note.querySelector('[data-note-stamp]');
      if (stamp) stamp.textContent = earned ? 'earned ✓' : own.length ? 'locked' : 'soon';
      if (earned && !seen.includes(note.dataset.note!)) {
        seen.push(note.dataset.note!);
        note.classList.add('is-fresh');
        fresh = true;
      }
    });
    if (fresh) {
      try {
        localStorage.setItem(EARNED, JSON.stringify(seen));
      } catch {}
      celebrate();
    }
  };
  addEventListener('sd-progress', paint);
  onPage(() => {
    if (document.querySelector('[data-mod]')) paint();
  });
</script>
