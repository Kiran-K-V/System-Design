{
  "name": "Uptime Labs",
  // Default Codespaces image: cached on Codespaces hosts, already has Docker and Python.
  // Adding features here (python, docker-in-docker) makes the first build take 10+ minutes.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  // Download and build lab images in the background so the first `./lab up` is quick.
  // Failure here is harmless: `./lab up` does the same work.
  "postCreateCommand": "cd labs/L04-cache-stampede && (docker compose --profile tools pull --quiet --ignore-buildable; docker compose --profile tools build --quiet) || true",
  "customizations": {
    "codespaces": {
      "openFiles": ["labs/L04-cache-stampede/README.md"]
    }
  }
}
